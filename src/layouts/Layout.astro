---
import {
  site,
  name,
  origin,
  routes,
  languages,
  text,
  type Language,
  type Page,
} from '../lib/site';
import Consent from '../components/Consent.astro';
import Header from '../components/Header.astro';
import '../styles/global.css';
const { lang, page, title, description } = Astro.props as {
  lang: Language;
  page: Page;
  title: string;
  description: string;
};
const t = text[lang];
const socialPage =
  page === 'events' || page === 'about' || page === 'contacts' ? page : 'home';
const socialFile =
  socialPage === 'about' ? `about-${lang}-v2.png` : `${socialPage}-${lang}.png`;
const socialImage = new URL(`/images/social/${socialFile}`, origin).toString();
const ogImageAlt =
  lang === 'de'
    ? `R.O.S.T. mit Logo und Motiv für ${text.de[socialPage]}`
    : `R.O.S.T. с логотипом и изображением для страницы «${text.ru[socialPage]}»`;
const orgId = `${origin}/#organization`;
const pageUrl = new URL(routes[page][lang], origin).toString();
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': orgId,
      name,
      url: origin,
      logo: new URL('/brand-tree.png', origin).toString(),
      email: site.legal.email,
      contactPoint: {
        '@type': 'ContactPoint',
        contactType: 'customer support',
        email: site.legal.email,
        availableLanguage: ['ru', 'de'],
      },
      knowsLanguage: ['ru', 'de'],
      areaServed: { '@type': 'Country', name: 'Germany' },
    },
    {
      '@type': 'WebSite',
      '@id': `${origin}/#website`,
      url: origin,
      name,
      inLanguage: lang,
      publisher: { '@id': orgId },
    },
    {
      '@type': 'WebPage',
      '@id': `${pageUrl}#webpage`,
      url: pageUrl,
      name: title,
      description,
      inLanguage: lang,
      isPartOf: { '@id': `${origin}/#website` },
      publisher: { '@id': orgId },
      primaryImageOfPage: {
        '@type': 'ImageObject',
        contentUrl: socialImage,
        width: 1200,
        height: 630,
        encodingFormat: 'image/png',
        caption: ogImageAlt,
      },
    },
  ],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link
      rel="preload"
      href="/fonts/Marmelad-Regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/Onest-Regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <title>{title} · {name}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={pageUrl} />
    {languages.map((l) => (
      <link
        rel="alternate"
        hreflang={l}
        href={new URL(routes[page][l], origin)}
      />
    ))}
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(routes[page][site.defaultLanguage as Language], origin)}
    />
    <meta property="og:site_name" content={name} />
    <meta property="og:title" content={`${title} · ${name}`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={lang === 'de' ? 'de_DE' : 'ru_RU'} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} · ${name}`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(structuredData)}
    ></script>
    <link rel="icon" href="/favicon.ico" sizes="32x32 48x48" />
    <link rel="icon" href="/favicon-48.png" type="image/png" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
  </head>
  <body
    class:list={[
      'min-h-dvh flex flex-col',
      {
        'home-page': page === 'home',
        'events-page': page === 'events',
        'hero-page': ['home', 'events', 'about', 'contacts'].includes(page),
      },
    ]}
  >
    <a class="fixed -top-20 focus:top-3 left-3 bg-white p-3 z-50" href="#main">
      {t.skip}
    </a>
    <Header lang={lang} page={page} />
    <main
      id="main"
      tabindex="-1"
      class={
        page === 'home'
          ? 'home-main flex-1'
          : page === 'events' || page === 'about' || page === 'contacts'
            ? 'flex-1'
            : 'site-container py-16 md:py-24 lg:py-28 flex-1'
      }
    >
      <slot />
    </main>
    <footer class="site-footer border-t border-line">
      <div class="site-footer__inner site-container">
        <span class="site-footer__copyright">
          © {new Date().getFullYear()} {name}
        </span>
        <nav
          class="site-footer__links"
          aria-label={lang === 'ru' ? 'Правовая информация' : 'Rechtliches'}
        >
          <a href={routes.imprint[lang]}>{t.imprint}</a>
          <a href={routes.privacy[lang]}>{t.privacy}</a>
          <button
            type="button"
            class="site-footer__cookie-settings"
            data-cc="show-preferencesModal"
          >
            {t.settings}
          </button>
        </nav>
      </div>
    </footer>
    <Consent />
    <script>
      import { initFacades } from '../lib/facade';
      initFacades();
    </script>
    <script>
      document
        .querySelectorAll<HTMLAnchorElement>('[data-language]')
        .forEach((a) =>
          a.addEventListener('click', () => {
            document.cookie = `site_language=${a.dataset.language}; Path=/; Max-Age=31536000; SameSite=Lax${location.protocol === 'https:' ? '; Secure' : ''}`;
          }),
        );
    </script>
  </body>
</html>
