---
import CtaSection from './ui/CtaSection.astro';
import PageIntro from './ui/PageIntro.astro';
import Button from './ui/Button.astro';
import Heading from './ui/Heading.astro';
import { routes, type Language } from '../lib/site';

const { lang } = Astro.props as { lang: Language };
const instagramPost = 'https://www.instagram.com/p/DeWzwDOqNv2/';
const instagramProfile = 'https://www.instagram.com/group_r.o.s.t/';
const copy =
  lang === 'ru'
    ? {
        eyebrow: 'АРХИВ МЕРОПРИЯТИЙ',
        title: 'Встреча-знакомство в Регенсбурге',
        intro: 'Тёплый день, после которого знакомых стало больше.',
        status: 'ВСТРЕЧА ПРОШЛА',
        date: '10 октября 2026 · Регенсбург',
        nextLink: 'Ближайшие мероприятия →',
        storyEyebrow: 'КАК ЭТО БЫЛО',
        storyTitle: 'Знакомство без неловкости',
        story:
          'Мы собрались небольшой компанией, чтобы познакомиться вживую. За чаем и кофе говорили о себе и своих планах, провели короткий нетворкинг и сыграли в «Крокодила».',
        moments: [
          [
            'Знакомились',
            'Короткие разговоры помогли каждому включиться в общение.',
          ],
          ['Играли', '«Крокодил» добавил встрече движения и смеха.'],
          ['Общались', 'За чаем и кофе было время поговорить свободнее.'],
        ],
        galleryEyebrow: 'АТМОСФЕРА ВСТРЕЧИ',
        galleryTitle: 'Несколько моментов этого дня',
        galleryCopy:
          'Короткое видео поможет вернуться в этот день: вспомнить знакомые лица, разговоры и атмосферу встречи. А если вас с нами не было, посмотрите, как всё прошло.',
        video: 'ВИДЕО В INSTAGRAM',
        instagramMore: 'Больше моментов:',
        instagramLink: 'Открыть видео в Instagram',
        nextEyebrow: 'ВСТРЕТИМСЯ СНОВА',
        nextTitle: 'Приходите на следующую встречу',
        nextCopy: 'Узнайте, где и когда мы увидимся в следующий раз.',
        photoAlt: 'Участники встречи в Регенсбурге',
      }
    : {
        eyebrow: 'VERANSTALTUNGSARCHIV',
        title: 'Kennenlerntreffen in Regensburg',
        intro: 'Ein warmer Tag, nach dem wir mehr Menschen kannten.',
        status: 'DAS TREFFEN IST VORBEI',
        date: '10. Oktober 2026 · Regensburg',
        nextLink: 'Nächste Veranstaltungen →',
        storyEyebrow: 'SO WAR ES',
        storyTitle: 'Kennenlernen ohne Hemmungen',
        story:
          'Wir kamen in einer kleinen Runde zusammen, um uns persönlich kennenzulernen. Bei Tee und Kaffee sprachen wir über uns und unsere Pläne, lernten einander in kurzen Gesprächen kennen und spielten „Krokodil“.',
        moments: [
          [
            'Kennenlernen',
            'Kurze Gespräche machten den Einstieg für alle leichter.',
          ],
          ['Spielen', '„Krokodil“ brachte Bewegung und Lachen in die Runde.'],
          ['Reden', 'Bei Tee und Kaffee blieb Zeit für entspannte Gespräche.'],
        ],
        galleryEyebrow: 'MOMENTE DES TREFFENS',
        galleryTitle: 'Ein paar Momente dieses Tages',
        galleryCopy:
          'Ein kurzes Video bringt die Begegnungen und die Atmosphäre dieses Tages zurück. Schau noch einmal hinein oder entdecke, wie unser Treffen war.',
        video: 'VIDEO AUF INSTAGRAM',
        instagramMore: 'Mehr Eindrücke:',
        instagramLink: 'Video auf Instagram öffnen',
        nextEyebrow: 'WIR SEHEN UNS WIEDER',
        nextTitle: 'Komm zum nächsten Treffen',
        nextCopy: 'Erfahre, wo und wann wir uns das nächste Mal sehen.',
        photoAlt: 'Teilnehmende beim Treffen in Regensburg',
      };
---

<div class="font-hero-sans text-brand">
  <section class="relative overflow-hidden bg-hero-start">
    <div class="site-container relative grid gap-12 pb-16 ui-page-top lg:grid-cols-[minmax(0,1fr)_420px] lg:items-center lg:pb-24">
      <PageIntro>
        <p class="ui-eyebrow">{copy.eyebrow}</p>
        <Heading as="h1" variant="page" class="max-w-3xl">
          {copy.title}
        </Heading>
        <p class="ui-lead mt-6 max-w-2xl text-muted">{copy.intro}</p>
        <p class="ui-eyebrow mt-7 inline-flex min-h-10 items-center justify-center rounded-full bg-white px-5">
          {copy.status}
        </p>
        <p class="mt-6 text-lg font-semibold">
          <time datetime="2026-10-10">{copy.date}</time>
        </p>
        <p class="mt-2 text-muted">St. Katharinenplatz 5, 93059 Regensburg</p>
        <Button
          variant="primary"
          size="regular"
          href={routes.events[lang]}
          class="mt-7"
        >
          {copy.nextLink}
        </Button>
      </PageIntro>
      <div class="relative mx-auto w-full max-w-[420px] lg:mx-0">
        <div
          aria-hidden="true"
          class="absolute -right-5 -top-5 h-full w-full rounded-4xl bg-hero-end"
        ></div>
        <picture class="relative block overflow-hidden rounded-4xl border-[6px] border-white shadow-xl">
          <source
            type="image/avif"
            srcset="/images/rost-networking-preview-600.avif 600w, /images/rost-networking-preview.avif 1200w"
            sizes="(min-width: 64rem) 420px, 100vw"
          />
          <source
            type="image/webp"
            srcset="/images/rost-networking-preview-600.webp 600w, /images/rost-networking-preview.webp 1200w"
            sizes="(min-width: 64rem) 420px, 100vw"
          />
          <img
            src="/images/rost-networking-preview.webp"
            alt={copy.photoAlt}
            width="1200"
            height="675"
            class="h-72 w-full object-cover md:h-96"
          />
        </picture>
      </div>
    </div>
  </section>

  <section class="ui-section bg-white">
    <div class="site-container">
      <div class="ui-section-heading">
        <p class="ui-eyebrow">{copy.storyEyebrow}</p>
        <Heading as="h2" variant="section" class="mt-6">
          {copy.storyTitle}
        </Heading>
      </div>
      <p class="mt-6 max-w-5xl text-lg leading-relaxed text-muted md:text-[22px]">
        {copy.story}
      </p>
      <div class="mt-12 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {copy.moments.map(([title, description], index) => (
          <article class="rounded-3xl bg-brand-surface p-7">
            <p class="text-lg text-events-placeholder-text">
              {String(index + 1).padStart(2, '0')}
            </p>
            <Heading as="h3" variant="card" class="mt-6">
              {title}
            </Heading>
            <p class="mt-4 leading-relaxed text-muted">{description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section
    class="ui-section bg-brand-surface"
    aria-labelledby="archive-moments-title"
  >
    <div class="site-container grid items-center gap-8 lg:grid-cols-[minmax(0,1fr)_360px] lg:gap-14">
      <div>
        <div class="ui-section-heading">
          <p class="ui-eyebrow">{copy.galleryEyebrow}</p>
          <Heading
            as="h2"
            variant="section"
            id="archive-moments-title"
            class="mt-4"
          >
            {copy.galleryTitle}
          </Heading>
        </div>
        <p class="mt-5 max-w-2xl text-lg leading-relaxed text-muted">
          {copy.galleryCopy}
        </p>
        <div class="mt-7 flex flex-wrap items-center gap-3">
          <p class="text-sm font-semibold text-muted">{copy.instagramMore}</p>
          <Button
            href={instagramProfile}
            variant="primary"
            target="_blank"
            rel="noopener noreferrer"
          >
            Instagram R.O.S.T.
          </Button>
        </div>
      </div>
      <a
        href={instagramPost}
        target="_blank"
        rel="noopener noreferrer"
        class="group relative block w-full max-w-90 justify-self-center overflow-hidden rounded-3xl bg-brand shadow-lg focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand lg:justify-self-end"
        aria-label={copy.instagramLink}
      >
        <picture>
          <source
            type="image/avif"
            srcset="/images/events/regensburg/reel-cover-360.avif 360w, /images/events/regensburg/reel-cover-720.avif 720w"
            sizes="(min-width: 400px) 360px, calc(100vw - 40px)"
          />
          <img
            src="/images/events/regensburg/reel-cover-720.webp"
            srcset="/images/events/regensburg/reel-cover-360.webp 360w, /images/events/regensburg/reel-cover-720.webp 720w"
            sizes="(min-width: 400px) 360px, calc(100vw - 40px)"
            alt={copy.photoAlt}
            width="720"
            height="1280"
            loading="lazy"
            decoding="async"
            class="block h-auto w-full"
          />
        </picture>
        <span
          aria-hidden="true"
          class="absolute inset-0 grid place-items-center bg-brand/5 transition group-hover:bg-brand/15"
        >
          <span class="grid h-18 w-18 place-items-center rounded-full bg-brand text-white shadow-lg transition group-hover:scale-105">
            <svg width="30" height="30" viewBox="0 0 24 24" fill="currentColor">
              <path d="M8 5.5v13l10-6.5z" />
            </svg>
          </span>
        </span>
        <span class="ui-eyebrow absolute inset-x-4 bottom-5 text-center text-white">
          {copy.video}
        </span>
      </a>
    </div>
  </section>

  <CtaSection
    title={copy.nextTitle}
    description={copy.nextCopy}
    eyebrow={copy.nextEyebrow}
    href={routes.events[lang]}
    label={copy.nextLink}
  />
</div>
