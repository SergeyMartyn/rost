---
import PageIntro from './ui/PageIntro.astro';
import Button from './ui/Button.astro';
import Heading from './ui/Heading.astro';
import { routes, type Language } from '../lib/site';
import VideoFacade from './VideoFacade.astro';

const { lang } = Astro.props as { lang: Language };

const copy =
  lang === 'ru'
    ? {
        eyebrow: 'R.O.S.T.: русскоязычное сообщество в Германии',
        lines: [
          'Сообщество людей,',
          'с которыми интересно',
          'знакомиться и',
          'развиваться вместе.',
        ],
        description: [
          'Находите своё окружение: людей,',
          'с которыми захочется встретиться снова.',
        ],
        join: 'Принять участие',
      }
    : {
        eyebrow: 'R.O.S.T.: russischsprachige Gemeinschaft in Deutschland',
        lines: [
          'Eine Gemeinschaft,',
          'in der Menschen sich',
          'kennenlernen und',
          'gemeinsam wachsen',
        ],
        description: [
          'Finde Menschen, die dein Umfeld bereichern',
          'und die du gern wiedersehen möchtest.',
        ],
        join: 'Mitmachen',
      };
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__inner site-container">
    <PageIntro class="hero__content">
      <p class="hero__eyebrow">{copy.eyebrow}</p>
      <Heading as="h1" variant="page" class="hero__title" id="hero-title">
        {copy.lines.map((line, index) => (
          <span
            class:list={[
              'hero__title-line',
              { 'hero__title-line--accent': index === copy.lines.length - 1 },
            ]}
          >
            {line}
          </span>
        ))}
      </Heading>
      <p class="hero__description">
        {copy.description.map((line) => (
          <span class="hero__description-line">{line} </span>
        ))}
      </p>
      <Button
        variant="primary"
        size="regular"
        class="hero__cta"
        href={routes.events[lang]}
      >
        {copy.join}
      </Button>
    </PageIntro>

    <VideoFacade lang={lang} page="home" />
  </div>
</section>
