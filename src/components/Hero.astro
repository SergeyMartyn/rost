---
import { routes, type Language } from '../lib/site';
import VideoFacade from './VideoFacade.astro';

const { lang } = Astro.props as { lang: Language };

const copy =
  lang === 'ru'
    ? {
        eyebrow: 'R.O.S.T. — русскоязычное сообщество в Германии',
        lines: [
          'Сообщество людей,',
          'которым интересно',
          'знакомиться и',
          'развиваться вместе',
        ],
        description: [
          'Находите своё окружение — людей,',
          'с которыми захочется встретиться снова.',
        ],
        join: 'Принять участие',
      }
    : {
        eyebrow: 'R.O.S.T. — russischsprachige Gemeinschaft in Deutschland',
        lines: [
          'Eine Gemeinschaft,',
          'in der Menschen sich',
          'kennenlernen und',
          'gemeinsam wachsen',
        ],
        description: [
          'Finde Menschen, die dein Umfeld bereichern',
          'und die du gern wiedersehen möchtest.',
        ],
        join: 'Mitmachen',
      };
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__inner site-container">
    <div class="hero__content">
      <p class="hero__eyebrow">{copy.eyebrow}</p>
      <h1 class="hero__title" id="hero-title">
        {copy.lines.map((line, index) => (
          <span
            class:list={[
              'hero__title-line',
              { 'hero__title-line--accent': index === copy.lines.length - 1 },
            ]}
          >
            {line}
          </span>
        ))}
      </h1>
      <p class="hero__description">
        {copy.description.map((line) => (
          <span class="hero__description-line">{line} </span>
        ))}
      </p>
      <a class="hero__cta" href={routes.events[lang]}>
        {copy.join}
      </a>
    </div>

    <VideoFacade lang={lang} page="home" />
  </div>
</section>
