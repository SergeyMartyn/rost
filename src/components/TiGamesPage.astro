---
import CtaSection from './ui/CtaSection.astro';
import EventValueSection from './ui/EventValueSection.astro';
import PageIntro from './ui/PageIntro.astro';
import Button from './ui/Button.astro';
import Heading from './ui/Heading.astro';
import { routes, type Language } from '../lib/site';
import { tiGames } from '../data/ti-games';
import TicketPurchaseDialog, {
  type PurchaseTicket,
} from './TicketPurchaseDialog.astro';

const { lang } = Astro.props as { lang: Language };
const content = tiGames[lang];
const ticketByKey = Object.fromEntries(
  content.tickets.map((ticket) => [ticket.key, ticket]),
);
const purchaseTickets: PurchaseTicket[] = content.tickets.map((ticket) => ({
  key: ticket.key,
  title: ticket.name,
  summary: `${content.datePill} · ${ticket.price}`,
}));
---

<div class="font-hero-sans text-brand">
  <div class="ti-lead bg-gradient-to-r from-hero-start to-hero-end ui-page-top">
    <div class="site-container lg:grid lg:grid-cols-[minmax(0,1fr)_360px] lg:items-start lg:gap-x-12">
      <PageIntro
        id="ti-games-hero"
        class="min-w-0 pb-12 md:pb-16 lg:col-start-1 lg:row-start-1"
      >
        <p class="ui-eyebrow text-brand">{content.eyebrow}</p>
        <p class="mt-5 inline-flex min-h-10 items-center rounded-full bg-brand-gold px-5 text-xs font-bold tracking-[0.08em] text-brand">
          {content.datePill}
        </p>
        <Heading as="h1" variant="page" class="break-words">
          {content.title.join(' ')}
        </Heading>
        <div
          class="ui-intro__rule mt-8 h-1 w-40 bg-brand-gold md:w-64 lg:mt-10 lg:w-90"
          aria-hidden="true"
        ></div>
        <p class="ui-lead mt-6 max-w-2xl text-muted">{content.intro}</p>
        <ul class="mt-7 grid max-w-2xl gap-3 text-sm text-brand sm:grid-cols-3 sm:gap-4">
          {content.heroHighlights.map((highlight) => (
            <li class="flex gap-2 border-l-2 border-brand-gold pl-3 leading-snug">
              {highlight}
            </li>
          ))}
        </ul>
      </PageIntro>

      <aside
        id="ti-ticket-card"
        class="relative z-10 mt-0 min-w-0 self-start overflow-hidden pb-10 lg:col-start-2 lg:row-span-3 lg:row-start-1 lg:mt-0 lg:sticky lg:top-28"
      >
        <div class="overflow-hidden rounded-4xl border border-brand/10 bg-white shadow-xl">
          <div class="bg-hero-end px-7 py-5 text-brand">
            <p class="ui-eyebrow">{content.when}</p>
            <p class="mt-3 font-display text-3xl">{content.date}</p>
            <p class="mt-2 text-sm">{content.arrival}</p>
          </div>
          <div class="p-6 sm:p-7">
            <p class="text-sm text-muted">
              {content.venue} · Perchtinger Straße 12
            </p>
            <fieldset class="mt-5">
              <legend class="mb-3 font-bold text-brand">
                {content.chooseTicket}
              </legend>
              <div class="space-y-3">
                <label class="ui-choice-card flex min-h-24 items-start gap-3">
                  <input
                    type="radio"
                    name="games-ticket"
                    value="guest"
                    class="mt-1 h-4 w-4 shrink-0 accent-brand"
                  />
                  <span class="flex min-w-0 flex-1 items-start gap-3">
                    <span class="min-w-0 flex-1">
                      <strong class="block text-sm">
                        {content.basicTicket}
                      </strong>
                      <span class="mt-1 block text-xs leading-snug text-muted">
                        {content.basicIncludes}
                      </span>
                    </span>
                    <strong class="shrink-0 font-display text-2xl font-normal">
                      {ticketByKey.guest.price}
                    </strong>
                  </span>
                </label>
                <label class="ui-choice-card flex min-h-24 items-start gap-3">
                  <input
                    type="radio"
                    name="games-ticket"
                    value="guest_peak"
                    checked
                    class="mt-1 h-4 w-4 shrink-0 accent-brand"
                  />
                  <span class="flex min-w-0 flex-1 items-start gap-3">
                    <span class="min-w-0 flex-1">
                      <strong class="block text-sm">
                        {content.peakTicket}
                      </strong>
                      <span class="mt-1 block text-xs leading-snug text-muted">
                        {content.peakIncludes}
                      </span>
                    </span>
                    <strong class="shrink-0 font-display text-2xl font-normal">
                      {ticketByKey.guest_peak.price}
                    </strong>
                  </span>
                </label>
              </div>
            </fieldset>
            <Button
              variant="primary"
              size="regular"
              type="button"
              data-ticket="guest"
              data-ticket-group="games-ticket"
              class="mt-5 w-full"
            >
              {content.buyTicket}
            </Button>
            <Button
              variant="secondary"
              size="compact"
              href={routes.host[lang]}
              class="mt-3 w-full"
            >
              <span>{content.host}</span>
              <span aria-hidden="true">→</span>
            </Button>
            <p class="mt-4 text-center text-xs leading-relaxed text-muted">
              {content.ticketNote}
            </p>
          </div>
        </div>
      </aside>

      <section
        class="ui-section ti-about min-w-0 lg:col-start-1 lg:row-start-2"
        aria-labelledby="ti-about-title"
      >
        <div class="ui-section-heading">
          <p class="ui-eyebrow text-accent">{content.aboutEyebrow}</p>
          <Heading as="h2" variant="section" id="ti-about-title" class="mt-4">
            {content.aboutTitle.map((line) => (
              <span class="block">{line}</span>
            ))}
          </Heading>
        </div>
        <p class="mt-5 max-w-2xl leading-relaxed text-muted">
          {content.aboutBody}
        </p>
        <div class="mt-7 grid gap-5 sm:grid-cols-3 sm:gap-3">
          {content.features.map((feature, index) => (
            <div class="sm:rounded-2xl sm:bg-brand-surface sm:p-4">
              <h3 class="font-bold">
                <span class="mr-2 text-brand-gold sm:hidden" aria-hidden="true">
                  ●
                </span>
                <span class="hidden text-xs tracking-[0.12em] text-accent sm:inline">
                  0{index + 1}{' '}
                </span>
                {feature.title}
              </h3>
              <p class="mt-1 text-sm leading-relaxed text-muted">
                {feature.body}
              </p>
            </div>
          ))}
        </div>
      </section>

      <section
        id="ti-program"
        class="ui-section ti-program min-w-0 scroll-mt-24 lg:col-start-1 lg:row-start-3"
        aria-labelledby="ti-program-title"
      >
        <div class="ui-section-heading">
          <p class="ui-eyebrow text-accent">{content.programEyebrow}</p>
          <Heading as="h2" variant="section" id="ti-program-title" class="mt-4">
            {content.programTitle}
          </Heading>
        </div>
        <div class="mt-6 grid gap-x-8 sm:grid-cols-2">
          {content.program.map((item) => (
            <div class="border-b border-line py-4 sm:flex sm:items-baseline sm:gap-4">
              <p class="text-sm font-bold tracking-[0.08em] text-accent">
                {item.time}
              </p>
              <p class="mt-1 text-base text-muted sm:mt-0">{item.label}</p>
            </div>
          ))}
        </div>
      </section>
    </div>
  </div>

  <EventValueSection lang={lang} audience="participants" />

  <section class="ui-section bg-white" aria-labelledby="ti-practitioners-title">
    <div class="site-container">
      <div class="ui-section-heading">
        <p class="ui-eyebrow text-accent">{content.practitionersEyebrow}</p>
        <Heading
          as="h2"
          variant="section"
          id="ti-practitioners-title"
          class="mt-4"
        >
          {content.practitionersTitle}
        </Heading>
      </div>
      <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {content.practitioners.map((person, index) => (
          <button
            type="button"
            class:list={[
              'group flex min-w-0 items-center gap-4 rounded-full border p-3 text-left transition hover:bg-brand-surface focus-visible:bg-brand-surface focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand sm:block sm:rounded-3xl sm:text-center',
              index === 0
                ? 'border-brand bg-hero-end hover:bg-hero-end focus-visible:bg-hero-end'
                : 'border-transparent bg-transparent',
            ]}
            data-practitioner={index}
            aria-haspopup="dialog"
            aria-controls="practitioner-dialog"
          >
            <img
              src={person.image}
              alt={person.name}
              width="160"
              height="160"
              loading="lazy"
              decoding="async"
              class="h-16 w-16 shrink-0 rounded-full border-4 border-white object-cover shadow-md transition group-hover:scale-[1.03] sm:mx-auto sm:h-32 sm:w-32"
            />
            <span class="block min-w-0">
              <span class="block font-display text-lg leading-tight text-brand sm:mt-4 sm:text-xl">
                {person.name}
                <span class="ml-1 inline-block" aria-hidden="true">
                  →
                </span>
              </span>
              <span class="mt-1 block text-sm font-semibold text-accent">
                {person.game}
              </span>
            </span>
          </button>
        ))}
      </div>
    </div>
  </section>

  <section
    class="ui-section bg-brand-surface"
    aria-labelledby="ti-tickets-title"
  >
    <div class="site-container">
      <div class="ui-section-heading">
        <p class="ui-eyebrow text-accent">{content.ticketsEyebrow}</p>
        <Heading as="h2" variant="section" id="ti-tickets-title" class="mt-4">
          {content.ticketsTitle}
        </Heading>
      </div>
      <fieldset class="mt-8 grid grid-cols-1 gap-4 md:grid-cols-2">
        <legend class="sr-only">{content.chooseTicket}</legend>
        {content.tickets.map((ticket, index) => (
          <label
            class:list={[
              'block cursor-pointer rounded-3xl border-2 border-line bg-white p-6 transition has-[:checked]:border-brand focus-within:outline-2 focus-within:outline-offset-2 focus-within:outline-brand',
            ]}
          >
            <span class="flex items-start justify-between gap-4">
              <span class="flex min-w-0 items-start gap-3">
                <input
                  type="radio"
                  name="games-ticket-details"
                  value={ticket.key}
                  checked={index === 1}
                  class="mt-2 h-4 w-4 shrink-0 accent-brand"
                />
                <span class="min-w-0 break-words font-display text-2xl">
                  {ticket.name}
                </span>
              </span>
              <strong class="shrink-0 font-display text-3xl font-normal">
                {ticket.price}
              </strong>
            </span>
            <span role="list" class="mt-5 block space-y-2">
              {ticket.includes.map((item) => (
                <span
                  role="listitem"
                  class="block text-sm leading-relaxed text-muted"
                >
                  {item}
                </span>
              ))}
            </span>
          </label>
        ))}
      </fieldset>
    </div>
  </section>

  <CtaSection
    title={content.questionsTitle}
    description={content.questionsBody}
    href={routes.contacts[lang]}
    label={content.contactLink}
  />
</div>

<Button
  variant="primary"
  size="regular"
  id="ti-sticky-buy"
  type="button"
  hidden
  class="fixed inset-x-4 bottom-4 z-40 shadow-xl lg:hidden"
>
  {content.buyTicket}
</Button>

<dialog
  id="practitioner-dialog"
  aria-labelledby="practitioner-name"
  class="m-auto h-[calc(100dvh-1rem)] w-[calc(100%-1rem)] max-h-[calc(100dvh-1rem)] max-w-none overflow-hidden rounded-4xl border-0 bg-white p-0 text-brand shadow-2xl backdrop:bg-brand/65 sm:h-auto sm:max-h-[min(90dvh,900px)] sm:w-[min(calc(100%-2rem),980px)]"
>
  <div class="flex h-full max-h-[calc(100dvh-1rem)] min-h-0 flex-col sm:max-h-[min(90dvh,900px)]">
    <div class="flex shrink-0 items-start justify-between gap-4 bg-white px-5 py-4 sm:px-8 sm:py-5">
      <p id="practitioner-counter" class="ui-eyebrow text-accent"></p>
      <button
        id="practitioner-close"
        type="button"
        aria-label={content.close}
        class="ui-icon-button"
      >
        ×
      </button>
    </div>
    <div class="min-h-0 overflow-y-auto overscroll-contain px-5 py-6 sm:px-8 sm:py-8">
      <div class="grid gap-6 sm:grid-cols-[260px_minmax(0,1fr)] sm:items-start">
        <img
          id="practitioner-image"
          src={content.practitioners[0].image}
          alt=""
          width="320"
          height="320"
          class="mx-auto h-48 w-48 rounded-full border-4 border-white object-cover shadow-lg sm:h-64 sm:w-64"
        />
        <div class="min-w-0">
          <Heading as="h2" variant="panel" id="practitioner-name" class="" />
          <p
            id="practitioner-qualification"
            class="mt-2 text-sm leading-relaxed text-muted"
          ></p>
          <div class="mt-5 h-0.5 w-full bg-brand-gold" aria-hidden="true"></div>
          <p id="practitioner-game" class="ui-eyebrow mt-5 text-accent"></p>
          <p
            id="practitioner-tagline"
            class="mt-4 font-display text-2xl leading-snug text-brand"
          ></p>
          <p id="practitioner-body" class="mt-4 leading-relaxed text-muted"></p>
          <section class="mt-7">
            <h3 class="text-sm font-bold">{content.factsLabel}</h3>
            <ul
              id="practitioner-facts"
              class="mt-3 list-disc space-y-2 pl-5 text-sm leading-relaxed text-muted marker:text-brand-gold"
            ></ul>
          </section>
          <section class="mt-7">
            <h3 class="text-sm font-bold">{content.fitLabel}</h3>
            <ul
              id="practitioner-fit"
              class="mt-3 list-disc space-y-2 pl-5 text-sm leading-relaxed text-muted marker:text-brand-gold"
            ></ul>
          </section>
          <section class="mt-7">
            <h3 class="text-sm font-bold">{content.resultsLabel}</h3>
            <ul
              id="practitioner-results"
              class="mt-3 list-disc space-y-2 pl-5 text-sm leading-relaxed text-muted marker:text-brand-gold"
            ></ul>
          </section>
          <section
            id="practitioner-other-game"
            class="mt-8 hidden border-t border-brand/15 pt-6"
          >
            <Heading
              as="h3"
              variant="panel"
              id="practitioner-other-name"
              class=""
            />
            <p class="mt-5 text-sm font-bold">{content.fitLabel}</p>
            <ul
              id="practitioner-other-fit"
              class="mt-3 list-disc space-y-2 pl-5 text-sm leading-relaxed text-muted marker:text-brand-gold"
            ></ul>
            <p class="mt-6 text-sm font-bold">{content.resultsLabel}</p>
            <ul
              id="practitioner-other-results"
              class="mt-3 list-disc space-y-2 pl-5 text-sm leading-relaxed text-muted marker:text-brand-gold"
            ></ul>
          </section>
          <p
            id="practitioner-note"
            class="mt-7 rounded-2xl bg-brand-surface p-4 text-sm font-semibold leading-relaxed text-brand"
          ></p>
        </div>
      </div>
    </div>
    <div class="shrink-0 border-t border-brand/10 bg-white px-5 py-4 sm:px-8">
      <p class="ui-eyebrow text-accent">{content.otherPractitioners}</p>
      <div class="mt-3 flex flex-wrap items-center gap-2">
        <div id="practitioner-nav" class="flex flex-wrap gap-2"></div>
        <button
          id="practitioner-all"
          type="button"
          class="ml-auto border-0 bg-transparent px-2 py-2 text-sm font-semibold text-brand underline underline-offset-4 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand"
        >
          {content.allPractitioners}
        </button>
      </div>
    </div>
  </div>
</dialog>

<script
  type="application/json"
  id="practitioner-data"
  set:html={JSON.stringify(content.practitioners)}
></script>

<TicketPurchaseDialog lang={lang} tickets={purchaseTickets} />

<script>
  const practitioners = JSON.parse(
    document.querySelector<HTMLScriptElement>('#practitioner-data')
      ?.textContent || '[]',
  ) as Array<{
    name: string;
    qualification: string;
    game: string;
    image: string;
    tagline: string;
    body: string;
    facts: string[];
    fit: string[];
    results: string[];
    otherGame?: { name: string; fit: string[]; results: string[] };
    note: string;
  }>;
  const practitionerDialog = document.querySelector<HTMLDialogElement>(
    '#practitioner-dialog',
  );
  const practitionerName =
    document.querySelector<HTMLElement>('#practitioner-name');
  const practitionerQualification = document.querySelector<HTMLElement>(
    '#practitioner-qualification',
  );
  const practitionerGame =
    document.querySelector<HTMLElement>('#practitioner-game');
  const practitionerTagline = document.querySelector<HTMLElement>(
    '#practitioner-tagline',
  );
  const practitionerBody =
    document.querySelector<HTMLElement>('#practitioner-body');
  const practitionerFacts = document.querySelector<HTMLElement>(
    '#practitioner-facts',
  );
  const practitionerFit =
    document.querySelector<HTMLElement>('#practitioner-fit');
  const practitionerResults = document.querySelector<HTMLElement>(
    '#practitioner-results',
  );
  const practitionerOtherGame = document.querySelector<HTMLElement>(
    '#practitioner-other-game',
  );
  const practitionerOtherName = document.querySelector<HTMLElement>(
    '#practitioner-other-name',
  );
  const practitionerOtherFit = document.querySelector<HTMLElement>(
    '#practitioner-other-fit',
  );
  const practitionerOtherResults = document.querySelector<HTMLElement>(
    '#practitioner-other-results',
  );
  const practitionerNote =
    document.querySelector<HTMLElement>('#practitioner-note');
  const practitionerImage = document.querySelector<HTMLImageElement>(
    '#practitioner-image',
  );
  const practitionerCounter = document.querySelector<HTMLElement>(
    '#practitioner-counter',
  );
  const practitionerNav =
    document.querySelector<HTMLElement>('#practitioner-nav');
  const closePractitioner = document.querySelector<HTMLButtonElement>(
    '#practitioner-close',
  );
  const allPractitioners =
    document.querySelector<HTMLButtonElement>('#practitioner-all');
  const isRu = document.documentElement.lang === 'ru';
  const gameLabel = isRu ? 'Игра' : 'Spiel';
  let practitionerTrigger: HTMLElement | null = null;

  const renderList = (element: HTMLElement | null, items: string[]) => {
    if (!element) return;
    element.replaceChildren(
      ...items.map((item) => {
        const li = document.createElement('li');
        li.textContent = item;
        return li;
      }),
    );
  };

  const renderPractitioner = (index: number) => {
    const person = practitioners[index];
    if (!person) return;
    if (practitionerName) practitionerName.textContent = person.name;
    if (practitionerQualification)
      practitionerQualification.textContent = person.qualification;
    if (practitionerGame)
      practitionerGame.textContent = `${gameLabel} · ${person.game}`;
    if (practitionerTagline) practitionerTagline.textContent = person.tagline;
    if (practitionerBody) practitionerBody.textContent = person.body;
    renderList(practitionerFacts, person.facts);
    renderList(practitionerFit, person.fit);
    renderList(practitionerResults, person.results);
    practitionerOtherGame?.classList.toggle('hidden', !person.otherGame);
    if (practitionerOtherName)
      practitionerOtherName.textContent = person.otherGame?.name || '';
    renderList(practitionerOtherFit, person.otherGame?.fit || []);
    renderList(practitionerOtherResults, person.otherGame?.results || []);
    if (practitionerNote) practitionerNote.textContent = person.note;
    if (practitionerImage) {
      practitionerImage.src = person.image;
      practitionerImage.alt = person.name;
    }
    if (practitionerCounter)
      practitionerCounter.textContent = isRu
        ? `Игропрактик · ${index + 1} из ${practitioners.length}`
        : `Spielleitende · ${index + 1} von ${practitioners.length}`;
    if (practitionerNav) {
      practitionerNav.innerHTML = '';
      practitioners.forEach((other, otherIndex) => {
        if (otherIndex === index) return;
        const button = document.createElement('button');
        button.type = 'button';
        button.className =
          'border-0 bg-transparent px-1 py-2 text-sm text-muted hover:text-brand hover:underline focus-visible:outline-2 focus-visible:outline-brand';
        button.textContent = other.name;
        button.addEventListener('click', () => renderPractitioner(otherIndex));
        practitionerNav.appendChild(button);
      });
    }
  };

  document
    .querySelectorAll<HTMLButtonElement>('[data-practitioner]')
    .forEach((button) => {
      button.addEventListener('click', () => {
        practitionerTrigger = button;
        const index = Number(button.dataset.practitioner || 0);
        renderPractitioner(Number.isFinite(index) ? index : 0);
        practitionerDialog?.showModal();
        closePractitioner?.focus();
      });
    });
  closePractitioner?.addEventListener('click', () =>
    practitionerDialog?.close(),
  );
  practitionerDialog?.addEventListener('click', (event) => {
    if (event.target === practitionerDialog) practitionerDialog.close();
  });
  practitionerDialog?.addEventListener('close', () => {
    practitionerTrigger?.focus();
    practitionerTrigger = null;
  });
  allPractitioners?.addEventListener('click', () =>
    practitionerDialog?.close(),
  );

  const stickyBuy = document.querySelector<HTMLButtonElement>('#ti-sticky-buy');
  const hero = document.querySelector<HTMLElement>('#ti-games-hero');
  const footer = document.querySelector<HTMLElement>('.site-footer');
  let heroVisible = true;
  let footerVisible = false;
  const updateStickyBuy = () => {
    const shouldShow =
      window.matchMedia('(max-width: 63.999rem)').matches &&
      !heroVisible &&
      !footerVisible;
    if (stickyBuy) stickyBuy.hidden = !shouldShow;
    document.body.style.paddingBottom = shouldShow ? '88px' : '';
  };
  if (hero)
    new IntersectionObserver((entries) => {
      heroVisible = entries[0]?.isIntersecting ?? false;
      updateStickyBuy();
    }).observe(hero);
  if (footer)
    new IntersectionObserver((entries) => {
      footerVisible = entries[0]?.isIntersecting ?? false;
      updateStickyBuy();
    }).observe(footer);
  window.addEventListener('resize', updateStickyBuy);

  const ticketRadios = document.querySelectorAll<HTMLInputElement>(
    'input[name="games-ticket"], input[name="games-ticket-details"]',
  );
  ticketRadios.forEach((radio) =>
    radio.addEventListener('change', () => {
      if (!radio.checked) return;
      ticketRadios.forEach((other) => {
        if (other.value === radio.value) other.checked = true;
      });
    }),
  );
  stickyBuy?.addEventListener('click', () => {
    document
      .querySelector<HTMLButtonElement>(
        '[data-ticket="guest"][data-ticket-group="games-ticket"]',
      )
      ?.click();
  });
</script>

<style>
  .ti-lead {
    isolation: isolate;
    overflow-x: clip;
  }

  .ti-about,
  .ti-program {
    position: relative;
    isolation: isolate;
  }

  .ti-about::before,
  .ti-program::before {
    position: absolute;
    z-index: -1;
    top: 0;
    bottom: 0;
