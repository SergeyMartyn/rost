---
import { routes, type Language } from '../lib/site';
import { tiGames } from '../data/ti-games';
import TicketPurchaseDialog, {
  type PurchaseTicket,
} from './TicketPurchaseDialog.astro';

const { lang } = Astro.props as { lang: Language };
const content = tiGames[lang];
const ticketByKey = Object.fromEntries(
  content.tickets.map((ticket) => [ticket.key, ticket]),
);
const purchaseTickets: PurchaseTicket[] = content.tickets.map((ticket) => ({
  key: ticket.key,
  title: ticket.name,
  summary: `${content.datePill} · ${ticket.price}`,
}));
---

<div class="font-hero-sans text-brand">
  <div class="bg-gradient-to-r from-hero-start to-hero-end pb-16 pt-32 md:pb-20 md:pt-36">
    <div class="site-container lg:grid lg:grid-cols-[minmax(0,1fr)_360px] lg:items-start lg:gap-12">
      <div id="ti-games-hero" class="min-w-0 lg:col-start-1 lg:row-start-1">
        <p class="text-xs font-bold uppercase tracking-[0.13em] text-brand md:text-[13px]">
          {content.eyebrow}
        </p>
        <p class="mt-5 inline-flex min-h-10 items-center rounded-full bg-brand-gold px-5 text-xs font-bold tracking-[0.08em] text-brand">
          {content.datePill}
        </p>
        <h1 class="mt-8 break-words font-display hyphens-auto text-[clamp(2rem,6vw,5rem)] leading-[1.05] tracking-[-0.02em]">
          {content.title.map((line) => (
            <span class="block">{line}</span>
          ))}
        </h1>
        <p class="mt-7 max-w-2xl text-lg leading-relaxed text-muted md:text-xl">
          {content.intro}
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a
            href="#ti-ticket-card"
            class="inline-flex min-h-14 items-center justify-center rounded-2xl bg-brand px-7 py-4 font-bold text-white transition hover:bg-accent hover:text-brand-gold"
          >
            {content.buyTicket}
          </a>
          <a
            href="#ti-program"
            class="inline-flex min-h-14 items-center justify-center rounded-2xl border border-brand/25 bg-white px-7 py-4 font-bold text-brand transition hover:border-brand hover:bg-brand hover:text-white"
          >
            {content.programEyebrow}
          </a>
        </div>
      </div>

      <aside
        id="ti-ticket-card"
        class="mt-10 min-w-0 self-start overflow-hidden lg:col-start-2 lg:row-span-3 lg:row-start-1 lg:mt-0 lg:sticky lg:top-28"
      >
        <div class="overflow-hidden rounded-4xl border border-brand/10 bg-white shadow-xl">
          <div class="relative flex items-end gap-3 overflow-hidden bg-hero-end/60 p-7 text-brand">
            <strong class="relative font-display text-7xl leading-none">7</strong>
            <span class="relative pb-2 text-lg font-semibold leading-tight">
              {lang === 'ru' ? 'ноября' : 'November'}
              <br />
              2026
            </span>
          </div>
          <div class="p-6 sm:p-7">
            <div class="rounded-2xl bg-brand-surface p-4">
              <p class="text-xs font-bold uppercase tracking-[0.14em] text-muted">
                {content.when}
              </p>
              <p class="mt-2 font-display text-xl">{content.date}</p>
              <p class="mt-1 text-sm text-muted">
                {content.venue} · {content.address}
              </p>
            </div>
            <fieldset class="mt-5">
              <legend class="mb-3 font-bold text-brand">
                {content.chooseTicket}
              </legend>
              <div class="space-y-3">
                <label class="block cursor-pointer">
                  <input
                    type="radio"
                    name="games-ticket"
                    value="guest"
                    class="peer sr-only"
                  />
                  <span class="flex min-h-24 items-start gap-3 rounded-2xl border border-line bg-white p-4 transition peer-checked:border-brand peer-checked:bg-brand-surface peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-brand">
                    <span class="mt-1 text-brand" aria-hidden="true">○</span>
                    <span class="min-w-0 flex-1">
                      <strong class="block text-sm">{content.basicTicket}</strong>
                      <span class="mt-1 block text-xs leading-snug text-muted">
                        {content.basicIncludes}
                      </span>
                    </span>
                    <strong class="shrink-0 font-display text-2xl font-normal">
                      {ticketByKey.guest.price}
                    </strong>
                  </span>
                </label>
                <label class="block cursor-pointer">
                  <input
                    type="radio"
                    name="games-ticket"
                    value="guest_peak"
                    checked
                    class="peer sr-only"
                  />
                  <span class="flex min-h-24 items-start gap-3 rounded-2xl border border-line bg-white p-4 transition peer-checked:border-brand peer-checked:bg-brand-surface peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-brand">
                    <span class="mt-1 text-brand" aria-hidden="true">○</span>
                    <span class="min-w-0 flex-1">
                      <strong class="block text-sm">{content.peakTicket}</strong>
                      <span class="mt-1 block text-xs leading-snug text-muted">
                        {content.peakIncludes}
                      </span>
                    </span>
                    <strong class="shrink-0 font-display text-2xl font-normal">
                      {ticketByKey.guest_peak.price}
                    </strong>
                  </span>
                </label>
              </div>
            </fieldset>
            <button
              type="button"
              data-ticket="guest"
              data-ticket-group="games-ticket"
              class="mt-5 w-full rounded-2xl bg-brand px-6 py-4 text-center font-bold text-white transition hover:bg-accent hover:text-brand-gold focus-visible:bg-accent focus-visible:text-brand-gold focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand"
            >
              {content.buyTicket}
            </button>
            <a
              href={routes.host[lang]}
              class="mt-3 inline-flex w-full items-center justify-between rounded-2xl border border-brand/30 bg-white px-5 py-3 text-left font-bold transition hover:border-brand hover:bg-brand hover:text-brand-gold"
            >
              <span>{content.host}</span>
              <span aria-hidden="true">→</span>
            </a>
            <p class="mt-4 text-center text-xs leading-relaxed text-muted">
              {content.ticketNote}
            </p>
          </div>
        </div>
      </aside>

      <section
        class="mt-14 min-w-0 rounded-4xl bg-white p-6 shadow-sm lg:col-start-1 lg:row-start-2 md:p-8"
        aria-labelledby="ti-about-title"
      >
        <p class="text-xs font-bold uppercase tracking-[0.13em] text-accent">
          {content.aboutEyebrow}
        </p>
        <h2
          id="ti-about-title"
          class="mt-4 font-display text-[clamp(2rem,4vw,3.5rem)] leading-tight"
        >
          {content.aboutTitle.map((line) => (
            <span class="block">{line}</span>
          ))}
        </h2>
        <p class="mt-5 max-w-2xl leading-relaxed text-muted">
          {content.aboutBody}
        </p>
        <div class="mt-7 grid gap-3 sm:grid-cols-3">
          {content.features.map((feature, index) => (
            <div class="rounded-2xl bg-brand-surface p-4">
              <p class="text-xs font-bold tracking-[0.12em] text-accent">
                0{index + 1}
              </p>
              <h3 class="mt-2 font-bold">{feature.title}</h3>
              <p class="mt-1 text-sm leading-relaxed text-muted">
                {feature.body}
              </p>
            </div>
          ))}
        </div>
      </section>

      <section
        id="ti-program"
        class="mt-10 min-w-0 scroll-mt-24 lg:col-start-1 lg:row-start-3"
        aria-labelledby="ti-program-title"
      >
        <p class="text-xs font-bold uppercase tracking-[0.13em] text-accent">
          {content.programEyebrow}
        </p>
        <h2
          id="ti-program-title"
          class="mt-4 font-display text-[clamp(2rem,4vw,3.5rem)] leading-tight"
        >
          {content.programTitle}
        </h2>
        <div class="mt-6 grid gap-3 sm:grid-cols-2">
          {content.program.map((item) => (
            <div class="rounded-2xl bg-white p-4">
              <p class="text-xs font-bold tracking-[0.08em] text-accent">
                {item.time}
              </p>
              <p class="mt-1 text-sm font-semibold text-brand">
                {item.label}
              </p>
            </div>
          ))}
        </div>
      </section>
    </div>
  </div>

  <section class="bg-white py-18 md:py-26" aria-labelledby="ti-practitioners-title">
    <div class="site-container">
      <p class="text-xs font-bold uppercase tracking-[0.13em] text-accent">
        {content.practitionersEyebrow}
      </p>
      <h2
        id="ti-practitioners-title"
        class="mt-4 font-display text-[clamp(2rem,4vw,3.5rem)] leading-tight"
      >
        {content.practitionersTitle}
      </h2>
      <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-5">
        {content.practitioners.map((person, index) => (
          <button
            type="button"
            class="group min-w-0 rounded-3xl border-0 bg-transparent p-2 text-center transition hover:bg-brand-surface focus-visible:bg-brand-surface focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand"
            data-practitioner={index}
            aria-haspopup="dialog"
            aria-controls="practitioner-dialog"
          >
            <img
              src={person.image}
              alt={person.name}
              width="160"
              height="160"
              loading="lazy"
              decoding="async"
              class="mx-auto h-32 w-32 rounded-full border-4 border-white object-cover shadow-md transition group-hover:scale-[1.03]"
            />
            <span class="mt-4 block font-display text-xl leading-tight text-brand">
              {person.name}
            </span>
            <span class="mt-1 block text-sm font-semibold text-accent">
              {person.game}
            </span>
          </button>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-brand-surface py-18 md:py-26" aria-labelledby="ti-tickets-title">
    <div class="site-container">
      <p class="text-xs font-bold uppercase tracking-[0.13em] text-accent">
        {content.ticketsEyebrow}
      </p>
      <h2
        id="ti-tickets-title"
        class="mt-4 font-display text-[clamp(2rem,4vw,3.5rem)] leading-tight"
      >
        {content.ticketsTitle}
      </h2>
      <div class="mt-8 grid gap-4 md:grid-cols-2">
        {content.tickets.map((ticket, index) => (
          <article
            class:list={[
              'rounded-3xl bg-white p-6',
              index === 1 ? 'border-2 border-brand' : 'border border-line',
            ]}
          >
            <div class="flex items-baseline justify-between gap-4">
              <h3 class="font-display text-2xl">{ticket.name}</h3>
              <strong class="shrink-0 font-display text-3xl font-normal">
                {ticket.price}
              </strong>
            </div>
            <ul class="mt-5 space-y-2">
              {ticket.includes.map((item) => (
                <li class="flex gap-2 text-sm leading-relaxed text-muted">
                  <span class="text-accent" aria-hidden="true">✓</span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-brand py-16 text-white md:py-20">
    <div class="site-container flex flex-col items-start justify-between gap-8 md:flex-row md:items-center">
      <div>
        <h2 class="font-display text-3xl md:text-4xl">
          {content.questionsTitle}
        </h2>
        <p class="mt-3 max-w-xl text-white/75">{content.questionsBody}</p>
      </div>
      <a
        href={routes.contacts[lang]}
        class="rounded-2xl border border-white/40 px-6 py-4 font-bold transition hover:bg-white hover:text-brand"
      >
        {content.contactLink}
      </a>
    </div>
  </section>
</div>

<button
  id="ti-sticky-buy"
  type="button"
  hidden
  class="fixed inset-x-4 bottom-4 z-40 rounded-2xl bg-brand px-6 py-4 text-center font-bold text-white shadow-xl transition hover:bg-accent hover:text-brand-gold focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand lg:hidden"
>
  {content.buyTicket}
</button>

<dialog
  id="ti-ticket-sheet"
  aria-labelledby="ti-sheet-title"
  class="m-auto mt-auto w-full max-w-none rounded-t-4xl border-0 bg-white p-0 text-brand shadow-2xl backdrop:bg-brand/65 sm:max-w-md sm:rounded-4xl"
>
  <div class="p-5 sm:p-6">
    <div class="flex items-start justify-between gap-4">
      <div>
        <p class="text-xs font-bold uppercase tracking-[0.14em] text-accent">
          {content.ticketsEyebrow} · {content.datePill}
        </p>
        <h2 id="ti-sheet-title" class="mt-2 font-display text-2xl">
          {content.chooseTicket}
        </h2>
      </div>
      <button
        id="ti-sheet-close"
        type="button"
        aria-label={content.close}
        class="grid h-10 w-10 shrink-0 place-items-center rounded-full border border-brand bg-brand-surface p-0 text-2xl leading-none"
      >
        ×
      </button>
    </div>
    <fieldset class="mt-5 space-y-3">
      <label class="block cursor-pointer">
        <input type="radio" name="ti-mobile-ticket" value="guest" class="peer sr-only" />
        <span class="flex min-h-24 items-start gap-3 rounded-2xl border border-line bg-white p-4 peer-checked:border-brand peer-checked:bg-brand-surface">
          <span class="mt-1 text-brand" aria-hidden="true">○</span>
          <span class="min-w-0 flex-1">
            <strong class="block">{content.basicTicket}</strong>
            <span class="mt-1 block text-xs text-muted">{content.basicIncludes}</span>
          </span>
          <strong class="shrink-0 font-display text-xl font-normal">
            {ticketByKey.guest.price}
          </strong>
        </span>
      </label>
      <label class="block cursor-pointer">
        <input type="radio" name="ti-mobile-ticket" value="guest_peak" checked class="peer sr-only" />
        <span class="flex min-h-24 items-start gap-3 rounded-2xl border border-line bg-white p-4 peer-checked:border-brand peer-checked:bg-brand-surface">
          <span class="mt-1 text-brand" aria-hidden="true">○</span>
          <span class="min-w-0 flex-1">
            <strong class="block">{content.peakTicket}</strong>
            <span class="mt-1 block text-xs text-muted">{content.peakIncludes}</span>
          </span>
          <strong class="shrink-0 font-display text-xl font-normal">
            {ticketByKey.guest_peak.price}
          </strong>
        </span>
      </label>
    </fieldset>
    <p class="mt-4 text-xs leading-relaxed text-muted">{content.ticketNote}</p>
    <button
      id="ti-sheet-continue"
      type="button"
      class="mt-5 w-full rounded-2xl bg-brand px-6 py-4 font-bold text-white"
    >
      {lang === 'ru' ? 'Продолжить' : 'Weiter'}
    </button>
  </div>
</dialog>

<dialog
  id="practitioner-dialog"
  aria-labelledby="practitioner-name"
  class="m-auto h-[calc(100dvh-1rem)] w-[calc(100%-1rem)] max-h-[calc(100dvh-1rem)] max-w-none overflow-hidden rounded-4xl border-0 bg-white p-0 text-brand shadow-2xl backdrop:bg-brand/65 sm:h-auto sm:max-h-[min(90dvh,900px)] sm:w-[min(calc(100%-2rem),980px)]"
>
  <div class="flex h-full max-h-[calc(100dvh-1rem)] min-h-0 flex-col sm:max-h-[min(90dvh,900px)]">
    <div class="flex shrink-0 items-start justify-between gap-4 border-b border-brand/10 bg-brand-surface px-5 py-4 sm:px-8 sm:py-5">
      <p id="practitioner-counter" class="text-xs font-bold uppercase tracking-[0.14em] text-accent"></p>
      <button
        id="practitioner-close"
        type="button"
        aria-label={content.close}
        class="grid h-11 w-11 shrink-0 place-items-center rounded-full border border-brand bg-white p-0 text-2xl leading-none"
      >
        ×
      </button>
    </div>
    <div class="min-h-0 overflow-y-auto overscroll-contain px-5 py-6 sm:px-8 sm:py-8">
      <div class="grid gap-6 sm:grid-cols-[260px_minmax(0,1fr)] sm:items-start">
        <img
          id="practitioner-image"
          src={content.practitioners[0].image}
          alt=""
          width="320"
          height="320"
          class="mx-auto h-48 w-48 rounded-full border-4 border-white object-cover shadow-lg sm:h-64 sm:w-64"
        />
        <div class="min-w-0">
          <h2 id="practitioner-name" class="font-display text-3xl leading-tight sm:text-4xl"></h2>
          <p id="practitioner-qualification" class="mt-2 text-sm leading-relaxed text-muted"></p>
          <p id="practitioner-game" class="mt-5 text-xs font-bold uppercase tracking-[0.14em] text-accent"></p>
          <p id="practitioner-tagline" class="mt-4 font-display text-2xl leading-snug text-brand"></p>
          <p id="practitioner-body" class="mt-4 leading-relaxed text-muted"></p>
          <p id="practitioner-fit-label" class="mt-6 text-sm font-bold text-brand"></p>
          <ul id="practitioner-fit" class="mt-2 space-y-1 text-sm leading-relaxed text-muted"></ul>
          <p id="practitioner-note" class="mt-5 rounded-xl bg-brand-surface p-3 text-sm font-semibold text-brand"></p>
        </div>
      </div>
    </div>
    <div class="shrink-0 border-t border-brand/10 bg-white px-5 py-4 sm:px-8">
      <p class="text-xs font-bold uppercase tracking-[0.14em] text-accent">
        {content.otherPractitioners}
      </p>
      <div class="mt-3 flex flex-wrap items-center gap-2">
        <div id="practitioner-nav" class="flex flex-wrap gap-2"></div>
        <button
          id="practitioner-all"
          type="button"
          class="ml-auto text-sm font-semibold underline underline-offset-4"
        >
          {content.allPractitioners}
        </button>
      </div>
    </div>
  </div>
</dialog>

<script type="application/json" id="practitioner-data" set:html={JSON.stringify(content.practitioners)}></script>

<TicketPurchaseDialog lang={lang} tickets={purchaseTickets} />

<script>
  const practitioners = JSON.parse(
    document.querySelector<HTMLScriptElement>('#practitioner-data')
      ?.textContent || '[]',
  ) as Array<{
    name: string;
    qualification: string;
    game: string;
    image: string;
    tagline: string;
    body: string;
    fit: string[];
    note: string;
  }>;
  const practitionerDialog = document.querySelector<HTMLDialogElement>(
    '#practitioner-dialog',
  );
  const practitionerName = document.querySelector<HTMLElement>(
    '#practitioner-name',
  );
  const practitionerQualification = document.querySelector<HTMLElement>(
    '#practitioner-qualification',
  );
  const practitionerGame = document.querySelector<HTMLElement>(
    '#practitioner-game',
  );
  const practitionerTagline = document.querySelector<HTMLElement>(
    '#practitioner-tagline',
  );
  const practitionerBody = document.querySelector<HTMLElement>(
    '#practitioner-body',
  );
  const practitionerFitLabel = document.querySelector<HTMLElement>(
    '#practitioner-fit-label',
  );
  const practitionerFit = document.querySelector<HTMLElement>(
    '#practitioner-fit',
  );
  const practitionerNote = document.querySelector<HTMLElement>(
    '#practitioner-note',
  );
  const practitionerImage = document.querySelector<HTMLImageElement>(
    '#practitioner-image',
  );
  const practitionerCounter = document.querySelector<HTMLElement>(
    '#practitioner-counter',
  );
  const practitionerNav = document.querySelector<HTMLElement>(
    '#practitioner-nav',
  );
  const closePractitioner = document.querySelector<HTMLButtonElement>(
    '#practitioner-close',
  );
  const allPractitioners = document.querySelector<HTMLButtonElement>(
    '#practitioner-all',
  );
  const isRu = document.documentElement.lang === 'ru';
  const gameLabel = isRu ? 'Игра' : 'Spiel';
  const fitLabel = isRu ? 'Подойдёт, если' : 'Passt, wenn';
  let practitionerTrigger: HTMLElement | null = null;

  const renderPractitioner = (index: number) => {
    const person = practitioners[index];
    if (!person) return;
    if (practitionerName) practitionerName.textContent = person.name;
    if (practitionerQualification)
      practitionerQualification.textContent = person.qualification;
    if (practitionerGame)
      practitionerGame.textContent = `${gameLabel} · ${person.game}`;
    if (practitionerTagline)
      practitionerTagline.textContent = person.tagline;
    if (practitionerBody) practitionerBody.textContent = person.body;
    if (practitionerFitLabel)
      practitionerFitLabel.textContent = fitLabel;
    if (practitionerFit)
      practitionerFit.innerHTML = person.fit
        .map((item) => `<li>• ${item}</li>`)
        .join('');
    if (practitionerNote) practitionerNote.textContent = person.note;
    if (practitionerImage) {
      practitionerImage.src = person.image;
      practitionerImage.alt = person.name;
    }
    if (practitionerCounter)
      practitionerCounter.textContent = isRu
        ? `Игропрактик · ${index + 1} из ${practitioners.length}`
        : `Spielleitende · ${index + 1} von ${practitioners.length}`;
    if (practitionerNav) {
      practitionerNav.innerHTML = '';
      practitioners.forEach((other, otherIndex) => {
        if (otherIndex === index) return;
        const button = document.createElement('button');
        button.type = 'button';
        button.className =
          'rounded-full border border-line px-3 py-2 text-sm font-semibold hover:border-brand hover:bg-brand-surface';
        button.textContent = other.name;
        button.addEventListener('click', () => renderPractitioner(otherIndex));
        practitionerNav.appendChild(button);
      });
    }
  };

  document.querySelectorAll<HTMLButtonElement>('[data-practitioner]').forEach(
    (button) => {
      button.addEventListener('click', () => {
        practitionerTrigger = button;
        const index = Number(button.dataset.practitioner || 0);
        renderPractitioner(Number.isFinite(index) ? index : 0);
        practitionerDialog?.showModal();
        closePractitioner?.focus();
      });
    },
  );
  closePractitioner?.addEventListener('click', () => practitionerDialog?.close());
  practitionerDialog?.addEventListener('click', (event) => {
    if (event.target === practitionerDialog) practitionerDialog.close();
  });
  practitionerDialog?.addEventListener('close', () => {
    practitionerTrigger?.focus();
    practitionerTrigger = null;
  });
  allPractitioners?.addEventListener('click', () => practitionerDialog?.close());

  const stickyBuy = document.querySelector<HTMLButtonElement>('#ti-sticky-buy');
  const hero = document.querySelector<HTMLElement>('#ti-games-hero');
  const footer = document.querySelector<HTMLElement>('.site-footer');
  let heroVisible = true;
  let footerVisible = false;
  const updateStickyBuy = () => {
    const shouldShow =
      window.matchMedia('(max-width: 63.999rem)').matches &&
      !heroVisible &&
      !footerVisible;
    if (stickyBuy) stickyBuy.hidden = !shouldShow;
    document.body.style.paddingBottom = shouldShow ? '88px' : '';
  };
  if (hero)
    new IntersectionObserver((entries) => {
      heroVisible = entries[0]?.isIntersecting ?? false;
      updateStickyBuy();
    }).observe(hero);
  if (footer)
    new IntersectionObserver((entries) => {
      footerVisible = entries[0]?.isIntersecting ?? false;
      updateStickyBuy();
    }).observe(footer);
  window.addEventListener('resize', updateStickyBuy);

  const sheet = document.querySelector<HTMLDialogElement>('#ti-ticket-sheet');
  const sheetClose = document.querySelector<HTMLButtonElement>('#ti-sheet-close');
  const sheetContinue =
    document.querySelector<HTMLButtonElement>('#ti-sheet-continue');
  stickyBuy?.addEventListener('click', () => {
    sheet?.showModal();
    sheetClose?.focus();
  });
  sheetClose?.addEventListener('click', () => sheet?.close());
  sheet?.addEventListener('click', (event) => {
    if (event.target === sheet) sheet.close();
  });
  sheetContinue?.addEventListener('click', () => {
    const selected = sheet?.querySelector<HTMLInputElement>(
      'input[name="ti-mobile-ticket"]:checked',
    )?.value;
    if (selected) {
      const main = document.querySelector<HTMLInputElement>(
        `input[name="games-ticket"][value="${selected}"]`,
      );
      if (main) main.checked = true;
    }
    sheet?.close();
    document
      .querySelector<HTMLButtonElement>(
        '[data-ticket="guest"][data-ticket-group="games-ticket"]',
      )
      ?.click();
  });
</script>
