---
import { munichMeetup } from '../data/munich-meetup';
import CtaSection from './ui/CtaSection.astro';
import PageIntro from './ui/PageIntro.astro';
import Button from './ui/Button.astro';
import Heading from './ui/Heading.astro';
import { routes, type Language } from '../lib/site';
import VideoFacade from './VideoFacade.astro';
import ArchiveLink from './ArchiveLink.astro';
import TicketPurchaseDialog from './TicketPurchaseDialog.astro';

const { lang } = Astro.props as { lang: Language };
const copy =
  lang === 'ru'
    ? {
        eyebrow: 'Встречаемся вживую',
        title: 'Мероприятия',
        intro:
          'Повод выйти из чата и познакомиться с людьми, с которыми захочется встретиться снова.',
        meetShort: '13 декабря · Нюрнберг ↗',
        meetTag: 'Первая встреча',
        meetTitle: 'Встреча-знакомство',
        meetPlace: 'и рождественский рынок в Нюрнберге',
        meetBody:
          'Встретимся, чтобы познакомиться лично и спокойно поговорить. После встречи вместе прогуляемся по Нюрнбергскому рождественскому рынку. Можно прийти одному: мы поможем включиться в разговор.',
        meetDetailsLink: 'Программа и подробности встречи →',
        meetDetailsTitle:
          'Встреча-знакомство и рождественский рынок в Нюрнберге',
        meetDetailsIntro:
          'Хотите расширить круг общения, найти компанию для совместных планов или познакомиться с людьми, близкими по интересам?',
        meetDetailsBody:
          'Мы подготовили встречу, где знакомство не придётся брать на себя: ведущие организуют общение так, чтобы каждый познакомился с каждым. А командная игра с юмором поможет узнать людей ближе: через их идеи, опыт и то, как они проявляют себя в общем деле.',
        meetDetailsEnd:
          'В завершение каждый сможет рассказать, чем может быть полезен и кого или что сейчас ищет,: чтобы знакомства получили продолжение после встречи.',
        meetDetailsClosing:
          'Можно прийти одному или с компанией. Главное: желание познакомиться. О том, как начать разговор, позаботимся мы. После встречи вместе отправимся на Нюрнбергский рождественский рынок.',
        meetDetailsClose: 'Закрыть описание встречи',
        meetDetailsBuy: 'Купить билет · €29',
        when: 'Когда',
        where: 'Где',
        meetDate: '13 декабря 2026',
        meetMonth: 'декабря',
        meetRegistration: 'Время начала сообщим позже',
        meetAddress: 'Адрес сообщим позже',
        meetTicket: 'Билет на встречу',
        buyTicket: 'Купить билет →',
        beforePayment: 'Перед оплатой попросим имя и удобный способ связи.',
        questions: 'Есть вопросы перед встречей?',
        questionsBody:
          'Порядок участия и время начала уточним перед мероприятием.',
        contactLink: 'Написать нам →',
        contactStep: 'Шаг 1 из 2 · Контакт',
        paymentStep: 'Шаг 2 из 2 · Оплата',
        close: 'Закрыть форму',
        name: 'Как к вам обращаться?',
        namePlaceholder: 'Ваше имя',
        channel: 'Где вам удобно написать?',
        contactLabel: 'Ваш аккаунт в Telegram',
        contactPlaceholder: '@username или номер телефона',
        contactUse: 'Используем контакт, чтобы сообщить детали встречи.',
        whatsappType: 'Как связаться с вами в WhatsApp?',
        whatsappPhone: 'По номеру',
        whatsappUsername: 'По нику',
        contactFor: 'Для',
        termsBefore: 'Я согласен с',
        termsLink: 'условиями участия',
        privacyBefore: 'и ознакомился с',
        privacyLink: 'политикой конфиденциальности',
        continue: 'Продолжить →',
        choosePayment: 'Выберите, как вам удобнее оплатить.',
        stripe: 'Картой через Stripe',
        paypal: 'Через PayPal',
        previewNote:
          'Оплата картой проходит на защищённой странице Stripe. Данные карты нам не передаются.',
        back: '← Изменить контакт',
      }
    : {
        eyebrow: 'Wir treffen uns persönlich',
        title: 'Veranstaltungen',
        intro:
          'Ein Anlass, den Chat zu verlassen und Menschen kennenzulernen, die du gern wiedersehen möchtest.',
        meetShort: '13. Dezember · Nürnberg ↗',
        meetTag: 'Erstes Treffen',
        meetTitle: 'Kennenlerntreffen',
        meetPlace: 'und Christkindlesmarkt in Nürnberg',
        meetBody:
          'Wir lernen uns persönlich kennen und unterhalten uns in Ruhe. Anschließend gehen wir gemeinsam zum Nürnberger Christkindlesmarkt. Du kannst auch allein kommen – wir helfen dir, ins Gespräch zu finden.',
        meetDetailsLink: 'Programm und Details →',
        meetDetailsTitle:
          'Kennenlerntreffen und Christkindlesmarkt in Nürnberg',
        meetDetailsIntro:
          'Möchtest du deinen Bekanntenkreis erweitern, Menschen für gemeinsame Unternehmungen finden oder neue Kontakte mit ähnlichen Interessen knüpfen?',
        meetDetailsBody:
          'Du musst nicht selbst nach einem Gesprächseinstieg suchen: Unsere Moderation gestaltet den Austausch so, dass alle einander kennenlernen. Ein lockeres Spiel in kleinen Teams sorgt für Humor und hilft euch, mehr voneinander zu erfahren.',
        meetDetailsEnd:
          'Zum Abschluss könnt ihr erzählen, wobei ihr andere unterstützen könnt und wen oder was ihr gerade sucht – damit aus der ersten Begegnung weitere Kontakte entstehen können.',
        meetDetailsClosing:
          'Du kannst allein oder in Begleitung kommen. Bring einfach Lust mit, neue Menschen kennenzulernen – wir helfen dir, ins Gespräch zu kommen. Danach besuchen wir gemeinsam den Nürnberger Christkindlesmarkt.',
        meetDetailsClose: 'Beschreibung des Treffens schließen',
        meetDetailsBuy: 'Ticket kaufen · €29',
        when: 'Wann',
        where: 'Wo',
        meetDate: '13. Dezember 2026',
        meetMonth: 'Dezember',
        meetRegistration: 'Die Anfangszeit geben wir noch bekannt',
        meetAddress: 'Die Adresse geben wir noch bekannt',
        meetTicket: 'Ticket für das Treffen',
        buyTicket: 'Ticket kaufen →',
        beforePayment:
          'Vor der Zahlung fragen wir nach deinem Namen und einem Kontaktweg.',
        questions: 'Noch Fragen zum Treffen?',
        questionsBody:
          'Details zum Ablauf und zur Anfangszeit teilen wir vor der Veranstaltung mit.',
        contactLink: 'Schreib uns →',
        contactStep: 'Schritt 1 von 2 · Kontakt',
        paymentStep: 'Schritt 2 von 2 · Zahlung',
        close: 'Formular schließen',
        name: 'Wie dürfen wir dich nennen?',
        namePlaceholder: 'Dein Name',
        channel: 'Wo können wir dich erreichen?',
        contactLabel: 'Dein Telegram-Konto',
        contactPlaceholder: '@username oder Telefonnummer',
        contactUse:
          'Wir nutzen deinen Kontakt, um dir die Details zum Treffen mitzuteilen.',
        whatsappType: 'Wie erreichen wir dich auf WhatsApp?',
        whatsappPhone: 'Per Telefonnummer',
        whatsappUsername: 'Per Benutzername',
        contactFor: 'Für',
        termsBefore: 'Ich stimme den',
        termsLink: 'Teilnahmebedingungen',
        privacyBefore: 'zu und habe die',
        privacyLink: 'Datenschutzerklärung',
        continue: 'Weiter →',
        choosePayment: 'Wähle, wie du bezahlen möchtest.',
        stripe: 'Mit Karte über Stripe',
        paypal: 'Mit PayPal',
        previewNote:
          'Die Zahlung erfolgt auf der gesicherten Seite von Stripe. Kartendaten erhalten wir nicht.',
        back: '← Kontakt ändern',
      };
const eventTickets = [
  {
    key: 'nuremberg_meetup',
    title: lang === 'ru' ? 'Билет на встречу' : 'Ticket für das Treffen',
    summary:
      lang === 'ru'
        ? '13 декабря · Нюрнберг · €29'
        : '13. Dezember · Nürnberg · €29',
  },
];
---

<div class="font-hero-sans text-brand">
  <section class="hero hero--events" aria-labelledby="hero-title">
    <div class="hero__inner site-container">
      <PageIntro class="hero__content">
        <p class="hero__eyebrow">{copy.eyebrow}</p>
        <Heading as="h1" variant="page" class="hero__title" id="hero-title">
          {copy.title}
          <br />
          <span class="text-accent">R.O.S.T.</span>
        </Heading>
        <p class="hero__description">{copy.intro}</p>
        <div class="hero__links">
          <Button variant="secondary" size="compact" href="#munich">
            {munichMeetup[lang].date} · {munichMeetup[lang].city}
          </Button>
          <Button variant="secondary" size="compact" href="#nuremberg">
            {copy.meetShort}
          </Button>
        </div>
      </PageIntro>
      <VideoFacade lang={lang} page="events" />
    </div>
  </section>

  <section id="munich" class="ui-section scroll-mt-24 bg-brand-surface">
    <div class="site-container">
      <div class="ui-section-heading">
        <time datetime={munichMeetup.datetime} class="ui-eyebrow text-accent">{munichMeetup[lang].date}</time>
        <Heading as="h2" variant="section" class="mt-4">{munichMeetup[lang].title}</Heading>
      </div>
      <p class="mt-5 text-lg text-muted">{munichMeetup[lang].details}</p>
      <Button variant="secondary" size="compact" href={routes.munichMeetup[lang]} class="mt-6">
        {munichMeetup[lang].link}
      </Button>
    </div>
  </section>

  <section id="nuremberg" class="ui-section scroll-mt-24 bg-white">
    <div class="site-container grid gap-9 lg:grid-cols-[minmax(0,1fr)_360px] lg:gap-14">
      <div class="min-w-0">
        <div class="mb-8 flex flex-wrap items-center gap-3">
          <span class="ui-eyebrow rounded-full bg-brand-surface px-4 py-2 text-accent">
            {copy.meetTag}
          </span>
          <span class="text-sm font-semibold text-muted">
            {lang === 'ru' ? 'Нюрнберг' : 'Nürnberg'}
          </span>
        </div>
        <Heading as="h2" variant="section" class="max-w-3xl">
          {copy.meetTitle}
          <br />
          {copy.meetPlace}
        </Heading>
        <p class="mt-7 max-w-2xl text-lg leading-relaxed text-muted">
          {copy.meetBody}
        </p>
        <div class="mt-10 grid max-w-2xl gap-4 sm:grid-cols-2">
          <div class="rounded-3xl bg-brand-surface p-6">
            <p class="ui-eyebrow text-muted">{copy.when}</p>
            <p class="mt-3 font-display text-2xl">{copy.meetDate}</p>
            <p class="mt-2 text-sm text-muted">{copy.meetRegistration}</p>
          </div>
          <div class="rounded-3xl bg-brand-surface p-6">
            <p class="ui-eyebrow text-muted">{copy.where}</p>
            <p class="mt-3 font-display text-2xl">
              {lang === 'ru' ? 'Нюрнберг' : 'Nürnberg'}
            </p>
            <p class="mt-2 text-sm text-muted">{copy.meetAddress}</p>
          </div>
        </div>
        <Button
          variant="secondary"
          size="compact"
          id="meet-details-open"
          type="button"
          aria-haspopup="dialog"
          aria-controls="meet-details-dialog"
          class="mt-6"
        >
          {copy.meetDetailsLink}
        </Button>
      </div>
      <aside class="min-w-0 self-start overflow-hidden rounded-4xl border border-brand/10 bg-brand-surface shadow-xl lg:sticky lg:top-28">
        <div class="relative flex h-48 items-end overflow-hidden bg-hero-end/60 p-7">
          <div
            aria-hidden="true"
            class="absolute -right-8 -top-16 h-60 w-60 rounded-full border-[2.5rem] border-white/40"
          ></div>
          <div class="relative flex items-end gap-3 text-brand">
            <strong class="font-display text-7xl leading-none">13</strong>
            <span class="pb-2 text-lg font-semibold leading-tight">
              {copy.meetMonth}
              <br />
              2026
            </span>
          </div>
        </div>
        <div class="p-7">
          <p class="text-sm font-semibold text-muted">{copy.meetTicket}</p>
          <p class="mt-2 font-display text-5xl">€29</p>
          <Button
            variant="primary"
            size="regular"
            type="button"
            data-ticket="nuremberg_meetup"
            class="mt-7 w-full"
          >
            {copy.buyTicket}
          </Button>
          <p class="mt-4 text-center text-xs leading-relaxed text-muted">
            {copy.beforePayment}
          </p>
        </div>
      </aside>
    </div>
  </section>

  <div id="games" class="scroll-mt-24">
    <ArchiveLink lang={lang} />
  </div>

  <CtaSection
    title={copy.questions}
    description={copy.questionsBody}
    href={routes.contacts[lang]}
    label={copy.contactLink}
  />
</div>

<dialog
  id="meet-details-dialog"
  aria-labelledby="meet-details-title"
  class="m-auto h-[calc(100dvh-1rem)] w-[calc(100%-1rem)] max-w-none max-h-[calc(100dvh-1rem)] overflow-hidden rounded-4xl border-0 bg-white p-0 text-brand shadow-2xl backdrop:bg-brand/65 sm:h-auto sm:max-w-[44rem] sm:max-h-[min(88dvh,900px)]"
>
  <div class="flex h-full max-h-[calc(100dvh-1rem)] min-h-0 flex-col sm:max-h-[min(88dvh,900px)]">
    <div class="flex shrink-0 items-start justify-between gap-4 border-b border-brand/10 bg-brand-surface px-5 py-5 sm:px-8 sm:py-6">
      <div class="min-w-0">
        <p class="ui-eyebrow text-accent">{copy.meetTag}</p>
        <Heading as="h2" variant="panel" id="meet-details-title" class="mt-2">
          {copy.meetDetailsTitle}
        </Heading>
        <p class="mt-2 text-sm text-muted">{copy.meetDate} · €29</p>
      </div>
      <button
        id="meet-details-close"
        type="button"
        aria-label={copy.meetDetailsClose}
        class="ui-icon-button"
      >
        <svg
          aria-hidden="true"
          viewBox="0 0 24 24"
          class="h-4 w-4"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
        >
          <path d="M5 5 19 19M19 5 5 19" />
        </svg>
      </button>
    </div>
    <div class="min-h-0 overflow-y-auto overscroll-contain px-5 py-6 text-base leading-relaxed text-muted sm:px-8 sm:py-8">
      <div class="space-y-4">
        <p class="font-semibold text-brand">{copy.meetDetailsIntro}</p>
        <p>{copy.meetDetailsBody}</p>
        <p>{copy.meetDetailsEnd}</p>
      </div>
      <p class="mt-7">{copy.meetDetailsClosing}</p>
    </div>
    <div class="shrink-0 border-t border-brand/10 bg-white px-5 py-4 sm:px-8">
      <Button
        variant="primary"
        size="regular"
        id="meet-details-buy"
        type="button"
        class="w-full"
      >
        {copy.meetDetailsBuy}
      </Button>
    </div>
  </div>
</dialog>

<TicketPurchaseDialog lang={lang} tickets={eventTickets} />

<script>
  const detailsDialog = document.querySelector<HTMLDialogElement>(
    '#meet-details-dialog',
  );
  const detailsOpen =
    document.querySelector<HTMLButtonElement>('#meet-details-open');
  const detailsClose = document.querySelector<HTMLButtonElement>(
    '#meet-details-close',
  );
  const detailsBuy =
    document.querySelector<HTMLButtonElement>('#meet-details-buy');
  let openingTicketFromDetails = false;
  detailsOpen?.addEventListener('click', () => detailsDialog?.showModal());
  detailsClose?.addEventListener('click', () => detailsDialog?.close());
  detailsDialog?.addEventListener('click', (event) => {
    if (event.target === detailsDialog) detailsDialog.close();
  });
  detailsDialog?.addEventListener('close', () => {
    if (!openingTicketFromDetails) detailsOpen?.focus();
    openingTicketFromDetails = false;
  });
  detailsBuy?.addEventListener('click', () => {
    openingTicketFromDetails = true;
    detailsDialog?.close();
    document
      .querySelector<HTMLButtonElement>('[data-ticket="nuremberg_meetup"]')
      ?.click();
  });
</script>
