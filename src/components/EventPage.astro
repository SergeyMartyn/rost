---

<div class="font-hero-sans text-brand">
  <section class="hero hero--events" aria-labelledby="hero-title">
    <div class="hero__inner site-container">
      <div class="hero__content">
        <p class="hero__eyebrow">{copy.eyebrow}</p>
        <h1 class="hero__title" id="hero-title">
          {copy.title}
          <br />
          <span class="text-accent">R.O.S.T.</span>
        </h1>
        <p class="hero__description">{copy.intro}</p>
        <div class="hero__links">
          <a
            href="#games"
            class="rounded-full border border-brand/15 bg-white px-5 py-3 transition hover:border-brand hover:bg-brand hover:text-white focus-visible:bg-brand focus-visible:text-white"
          >
            {copy.gamesShort}
          </a>
          <a
            href="#nuremberg"
            class="rounded-full border border-brand/15 bg-white px-5 py-3 transition hover:border-brand hover:bg-brand hover:text-white focus-visible:bg-brand focus-visible:text-white"
          >
            {copy.meetShort}
          </a>
        </div>
      </div>
      <VideoFacade lang={lang} page="events" />
    </div>
  </section>

  <section id="games" class="scroll-mt-24 bg-brand-surface py-18 md:py-26">
    <div class="site-container grid gap-9 lg:grid-cols-[minmax(0,1fr)_360px] lg:gap-14">
      <div class="min-w-0">
        <div class="mb-8 flex flex-wrap items-center gap-3">
          <span class="rounded-full bg-white px-4 py-2 text-xs font-bold uppercase tracking-[0.13em] text-accent">
            {copy.gamesTag}
          </span>
          <span class="text-sm font-semibold text-muted">
            {lang === 'ru' ? 'Мюнхен' : 'München'}
          </span>
        </div>
        <h2 class="max-w-3xl font-display text-[clamp(1.75rem,5vw,5.2rem)] leading-[1.03] tracking-[-0.035em]">
          {copy.gamesTitle}
          <br />
          {copy.gamesPlace}
        </h2>
        <p class="mt-7 max-w-2xl text-lg leading-relaxed text-muted">
          {copy.gamesBody}
        </p>
        <button
          id="games-details-open"
          type="button"
          aria-haspopup="dialog"
          aria-controls="games-details-dialog"
          class="mt-6 inline-flex min-h-12 items-center rounded-xl border border-brand/20 bg-white px-5 py-3 font-semibold text-brand transition hover:border-brand hover:bg-brand hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand"
        >
          {copy.gamesDetailsLink}
        </button>
        <div class="mt-10 grid max-w-2xl gap-4 sm:grid-cols-2">
          <div class="rounded-3xl bg-white/75 p-6">
            <p class="text-xs font-bold uppercase tracking-[0.16em] text-muted">
              {copy.when}
            </p>
            <p class="mt-3 font-display text-2xl">{copy.gamesDate}</p>
            <p class="mt-2 text-sm text-muted">{copy.timeLater}</p>
          </div>
          <div class="rounded-3xl bg-white/75 p-6">
            <p class="text-xs font-bold uppercase tracking-[0.16em] text-muted">
              {copy.where}
            </p>
            <p class="mt-3 font-display text-2xl">{copy.gamesVenue}</p>
            <p class="mt-2 text-sm text-muted">{copy.gamesAddress}</p>
          </div>
        </div>
      </div>
      <aside class="min-w-0 self-start overflow-hidden rounded-4xl border border-brand/10 bg-white shadow-xl lg:sticky lg:top-28">
        <div class="relative flex h-40 items-end overflow-hidden bg-hero-end/60 p-7">
          <div
            aria-hidden="true"
            class="absolute -right-8 -top-16 h-60 w-60 rounded-full border-[2.5rem] border-white/40"
          ></div>
          <div class="relative flex items-end gap-3 text-brand">
            <strong class="font-display text-7xl leading-none">7</strong>
            <span class="pb-2 text-lg font-semibold leading-tight">
              {copy.gamesMonth}
              <br />
              2026
            </span>
          </div>
        </div>
        <div class="p-7">
          <fieldset id="games-ticket-options">
            <legend class="mb-3 font-bold text-brand">
              {copy.chooseTicket}
            </legend>
            <div class="space-y-3">
              <label class="block cursor-pointer">
                <input
                  type="radio"
                  name="games-ticket"
                  value="guest"
                  class="peer sr-only"
                />
                <span class="flex min-h-24 items-start gap-3 rounded-2xl border border-line bg-white p-4 transition peer-checked:border-brand peer-checked:bg-brand-surface peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-brand">
                  <span class="mt-1 text-brand" aria-hidden="true">
                    ○
                  </span>
                  <span class="min-w-0 flex-1">
                    <strong class="block text-sm">{copy.basicTicket}</strong>
                    <span class="mt-1 block text-xs leading-snug text-muted">
                      {copy.basicIncludes}
                    </span>
                  </span>
                  <strong class="shrink-0 font-display text-2xl font-normal">
                    80 €
                  </strong>
                </span>
              </label>
              <label class="block cursor-pointer">
                <input
                  type="radio"
                  name="games-ticket"
                  value="guest_peak"
                  checked
                  class="peer sr-only"
                />
                <span class="flex min-h-24 items-start gap-3 rounded-2xl border border-line bg-white p-4 transition peer-checked:border-brand peer-checked:bg-brand-surface peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-brand">
                  <span class="mt-1 text-brand" aria-hidden="true">
                    ○
                  </span>
                  <span class="min-w-0 flex-1">
                    <strong class="block text-sm">{copy.peakTicket}</strong>
                    <span class="mt-1 block text-xs leading-snug text-muted">
                      {copy.peakIncludes}
                    </span>
                  </span>
                  <strong class="shrink-0 font-display text-2xl font-normal">
                    180 €
                  </strong>
                </span>
              </label>
            </div>
          </fieldset>
          <button
            type="button"
            data-ticket="guest"
            class="mt-4 w-full rounded-2xl bg-brand px-6 py-4 text-center font-bold text-white transition hover:bg-accent hover:text-brand-gold focus-visible:bg-accent focus-visible:text-brand-gold focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand"
          >
            {copy.guest}
          </button>
          <a
            href={routes.host[lang]}
            class="mt-3 inline-flex w-full items-center justify-between rounded-2xl border border-brand/30 bg-white px-5 py-4 text-left font-bold transition hover:border-brand hover:bg-brand hover:text-brand-gold focus-visible:bg-brand focus-visible:text-brand-gold focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand"
          >
            <span>{copy.host}</span>
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </aside>
    </div>
  </section>

  <section id="nuremberg" class="scroll-mt-24 bg-white py-18 md:py-26">
    <div class="site-container grid gap-9 lg:grid-cols-[minmax(0,1fr)_360px] lg:gap-14">
      <div class="min-w-0">
        <div class="mb-8 flex flex-wrap items-center gap-3">
          <span class="rounded-full bg-brand-surface px-4 py-2 text-xs font-bold uppercase tracking-[0.13em] text-accent">
            {copy.meetTag}
          </span>
          <span class="text-sm font-semibold text-muted">
            {lang === 'ru' ? 'Нюрнберг' : 'Nürnberg'}
          </span>
        </div>
        <h2 class="max-w-3xl font-display text-[clamp(2.1rem,5vw,5.2rem)] leading-[1.03] tracking-[-0.035em]">
          {copy.meetTitle}
          <br />
          {copy.meetPlace}
        </h2>
        <p class="mt-7 max-w-2xl text-lg leading-relaxed text-muted">
          {copy.meetBody}
        </p>
        <button
          id="meet-details-open"
          type="button"
          aria-haspopup="dialog"
          aria-controls="meet-details-dialog"
          class="mt-6 inline-flex min-h-12 items-center rounded-xl border border-brand/20 bg-brand-surface px-5 py-3 font-semibold text-brand transition hover:border-brand hover:bg-brand hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand"
        >
