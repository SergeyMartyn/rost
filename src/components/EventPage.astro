---
import { routes, type Language } from '../lib/site';
import { isEarlyBirdActive } from '../lib/early-bird';
import VideoFacade from './VideoFacade.astro';

const { lang } = Astro.props as { lang: Language };
const earlyBirdInitially = isEarlyBirdActive(Date.now());
const copy =
  lang === 'ru'
    ? {
        eyebrow: 'Встречаемся вживую',
        title: 'Мероприятия',
        intro:
          'Повод выйти из чата и познакомиться с людьми, с которыми захочется встретиться снова.',
        meetShort: '10 октября · Регенсбург ↗',
        gamesShort: '7 ноября · Мюнхен ↗',
        meetTag: 'Первая встреча',
        meetTitle: 'Встреча-знакомство',
        meetPlace: 'в Регенсбурге',
        meetBody:
          'Встретимся, чтобы познакомиться лично, спокойно поговорить и провести время в хорошей компании. Можно прийти одному — мы поможем включиться в разговор.',
        meetDetailsLink: 'Программа и подробности встречи →',
        meetDetailsTitle: 'Встреча-знакомство в Регенсбурге',
        meetDetailsIntro:
          'Хотите расширить круг общения, найти компанию для совместных планов или познакомиться с людьми, близкими по интересам?',
        meetDetailsBody:
          'Мы подготовили встречу, где знакомство не придётся брать на себя: ведущие организуют общение так, чтобы каждый познакомился с каждым. А командная игра с юмором поможет узнать людей ближе — через их идеи, опыт и то, как они проявляют себя в общем деле.',
        meetDetailsEnd:
          'В завершение каждый сможет рассказать, чем может быть полезен и кого или что сейчас ищет, — чтобы знакомства получили продолжение после встречи.',
        meetScheduleTitle: 'Как пройдёт встреча',
        meetSchedule: [
          ['09:45', 'Сбор и регистрация'],
          ['10:15', 'Приветствие и начало встречи'],
          ['10:30', 'Модерируемое знакомство: каждый с каждым'],
          ['11:30', 'Игра-знакомство в небольших командах'],
          ['13:30', 'Завершение'],
          ['14:00', 'Совместный обед по желанию'],
        ],
        meetDetailsClosing:
          'Можно прийти одному или с компанией. Главное — желание познакомиться. О том, как начать разговор, позаботимся мы.',
        meetDetailsClose: 'Закрыть описание встречи',
        meetDetailsBuy: 'Купить билет · 29 €',
        when: 'Когда',
        where: 'Где',
        meetDate: '10 октября 2026',
        gamesDate: '7 ноября 2026',
        meetMonth: 'октября',
        gamesMonth: 'ноября',
        timeLater: 'Время уточняется',
        meetRegistration: 'Сбор и регистрация с 09:45',
        meetAddress: 'Санкт-Катариненплац, 5 · 93059 Регенсбург',
        gamesVenue: 'Мюнхен',
        gamesAddress: 'Перхтингер-штрассе, 12 · 81379 Мюнхен',
        meetTicket: 'Билет на встречу',
        buyTicket: 'Купить билет →',
        beforePayment: 'Перед оплатой попросим имя и удобный способ связи.',
        gamesTag: 'Для участников и ведущих',
        gamesTitle: 'Трансформационные',
        gamesPlace: 'игры в Мюнхене',
        gamesBody:
          'День, в котором можно попробовать новый формат, посмотреть на свои вопросы с другой стороны и пообщаться с людьми. Для гостей и тех, кто проводит игры, предусмотрены разные билеты.',
        role: 'Выберите свою роль',
        guest: 'Я участник',
        earlyBirdUntil: 'Ранняя цена до 15 октября',
        host: 'Я ведущий игр',
        roleSaved: 'Роль и стоимость сохранятся в следующем шаге.',
        questions: 'Есть вопросы перед встречей?',
        questionsBody:
          'Порядок участия и время начала уточним перед мероприятием.',
        contactLink: 'Написать нам →',
        contactStep: 'Шаг 1 из 2 · Контакт',
        paymentStep: 'Шаг 2 из 2 · Оплата',
        close: 'Закрыть форму',
        name: 'Как к вам обращаться?',
        namePlaceholder: 'Ваше имя',
        channel: 'Где вам удобно написать?',
        contactLabel: 'Ваш аккаунт в Telegram',
        contactPlaceholder: '@username или номер телефона',
        contactUse: 'Используем контакт, чтобы сообщить детали встречи.',
        whatsappType: 'Как связаться с вами в WhatsApp?',
        whatsappPhone: 'По номеру',
        whatsappUsername: 'По нику',
        contactFor: 'Для',
        termsBefore: 'Я согласен с',
        termsLink: 'условиями участия',
        privacyBefore: 'и ознакомился с',
        privacyLink: 'политикой конфиденциальности',
        continue: 'Продолжить →',
        choosePayment: 'Выберите, как вам удобнее оплатить.',
        stripe: 'Картой через Stripe',
        paypal: 'Через PayPal',
        previewNote:
          'Оплата картой проходит на защищённой странице Stripe. Данные карты нам не передаются.',
        back: '← Изменить контакт',
      }
    : {
        eyebrow: 'Wir treffen uns persönlich',
        title: 'Veranstaltungen',
        intro:
          'Ein Anlass, den Chat zu verlassen und Menschen kennenzulernen, die du gern wiedersehen möchtest.',
        meetShort: '10. Oktober · Regensburg ↗',
        gamesShort: '7. November · München ↗',
        meetTag: 'Erstes Treffen',
        meetTitle: 'Kennenlerntreffen',
        meetPlace: 'in Regensburg',
        meetBody:
          'Wir lernen uns persönlich kennen, unterhalten uns in Ruhe und verbringen Zeit miteinander. Du kannst auch allein kommen – wir helfen dir, ins Gespräch zu finden.',
        meetDetailsLink: 'Programm und Details →',
        meetDetailsTitle: 'Kennenlerntreffen in Regensburg',
        meetDetailsIntro:
          'Möchtest du deinen Bekanntenkreis erweitern, Menschen für gemeinsame Unternehmungen finden oder neue Kontakte mit ähnlichen Interessen knüpfen?',
        meetDetailsBody:
          'Du musst nicht selbst nach einem Gesprächseinstieg suchen: Unsere Moderation gestaltet den Austausch so, dass alle einander kennenlernen. Ein lockeres Spiel in kleinen Teams sorgt für Humor und hilft euch, mehr voneinander zu erfahren.',
        meetDetailsEnd:
          'Zum Abschluss könnt ihr erzählen, wobei ihr andere unterstützen könnt und wen oder was ihr gerade sucht – damit aus der ersten Begegnung weitere Kontakte entstehen können.',
        meetScheduleTitle: 'So läuft das Treffen ab',
        meetSchedule: [
          ['09:45', 'Ankommen und Registrierung'],
          ['10:15', 'Begrüßung und gemeinsamer Start'],
          ['10:30', 'Moderiertes Kennenlernen: Alle lernen einander kennen'],
          ['11:30', 'Kennenlernspiel in kleinen Teams'],
          ['13:30', 'Abschluss'],
          ['14:00', 'Gemeinsames Mittagessen auf Wunsch'],
        ],
        meetDetailsClosing:
          'Du kannst allein oder in Begleitung kommen. Bring einfach Lust mit, neue Menschen kennenzulernen – wir helfen dir, ins Gespräch zu kommen.',
        meetDetailsClose: 'Beschreibung des Treffens schließen',
        meetDetailsBuy: 'Ticket kaufen · 29 €',
        when: 'Wann',
        where: 'Wo',
        meetDate: '10. Oktober 2026',
        gamesDate: '7. November 2026',
        meetMonth: 'Oktober',
        gamesMonth: 'November',
        timeLater: 'Uhrzeit folgt',
        meetRegistration: 'Ankommen und Registrierung ab 09:45 Uhr',
        meetAddress: 'St. Katharinenplatz 5 · 93059 Regensburg',
        gamesVenue: 'München',
        gamesAddress: 'Perchtinger Straße 12 · 81379 München',
        meetTicket: 'Ticket für das Treffen',
        buyTicket: 'Ticket kaufen →',
        beforePayment:
          'Vor der Zahlung fragen wir nach deinem Namen und einem Kontaktweg.',
        gamesTag: 'Für Gäste und Spielleitende',
        gamesTitle: 'Transformationsspiele',
        gamesPlace: 'in München',
        gamesBody:
          'Ein Tag, an dem du ein neues Format ausprobieren, deine Fragen aus einer anderen Perspektive betrachten und Menschen kennenlernen kannst. Für Gäste und Spielleitende gibt es unterschiedliche Tickets.',
        role: 'Wähle deine Rolle',
        guest: 'Ich nehme teil',
        earlyBirdUntil: 'Frühbucherpreis bis 15. Oktober',
        host: 'Ich leite Spiele',
        roleSaved: 'Rolle und Preis bleiben im nächsten Schritt sichtbar.',
        questions: 'Noch Fragen zum Treffen?',
        questionsBody:
          'Details zum Ablauf und zur Anfangszeit teilen wir vor der Veranstaltung mit.',
        contactLink: 'Schreib uns →',
        contactStep: 'Schritt 1 von 2 · Kontakt',
        paymentStep: 'Schritt 2 von 2 · Zahlung',
        close: 'Formular schließen',
        name: 'Wie dürfen wir dich nennen?',
        namePlaceholder: 'Dein Name',
        channel: 'Wo können wir dich erreichen?',
        contactLabel: 'Dein Telegram-Konto',
        contactPlaceholder: '@username oder Telefonnummer',
        contactUse:
          'Wir nutzen deinen Kontakt, um dir die Details zum Treffen mitzuteilen.',
        whatsappType: 'Wie erreichen wir dich auf WhatsApp?',
        whatsappPhone: 'Per Telefonnummer',
        whatsappUsername: 'Per Benutzername',
        contactFor: 'Für',
        termsBefore: 'Ich stimme den',
        termsLink: 'Teilnahmebedingungen',
        privacyBefore: 'zu und habe die',
        privacyLink: 'Datenschutzerklärung',
        continue: 'Weiter →',
        choosePayment: 'Wähle, wie du bezahlen möchtest.',
        stripe: 'Mit Karte über Stripe',
        paypal: 'Mit PayPal',
        previewNote:
          'Die Zahlung erfolgt auf der gesicherten Seite von Stripe. Kartendaten erhalten wir nicht.',
        back: '← Kontakt ändern',
      };
---

<div class="font-hero-sans text-brand">
  <section class="hero hero--events" aria-labelledby="hero-title">
    <div class="hero__inner site-container">
      <div class="hero__content">
        <p class="hero__eyebrow">{copy.eyebrow}</p>
        <h1 class="hero__title" id="hero-title">
          {copy.title}
          <br />
          <span class="text-accent">R.O.S.T.</span>
        </h1>
        <p class="hero__description">{copy.intro}</p>
        <div class="hero__links">
          <a
            href="#regensburg"
            class="rounded-full border border-brand/15 bg-white px-5 py-3 transition hover:border-brand hover:bg-brand hover:text-white focus-visible:bg-brand focus-visible:text-white"
          >
            {copy.meetShort}
          </a>
          <a
            href="#games"
            class="rounded-full border border-brand/15 bg-white px-5 py-3 transition hover:border-brand hover:bg-brand hover:text-white focus-visible:bg-brand focus-visible:text-white"
          >
            {copy.gamesShort}
          </a>
        </div>
      </div>
      <VideoFacade lang={lang} page="events" />
    </div>
  </section>

  <section id="regensburg" class="scroll-mt-24 bg-white py-18 md:py-26">
    <div class="site-container grid gap-9 lg:grid-cols-[minmax(0,1fr)_360px] lg:gap-14">
      <div class="min-w-0">
        <div class="mb-8 flex flex-wrap items-center gap-3">
          <span class="rounded-full bg-brand-surface px-4 py-2 text-xs font-bold uppercase tracking-[0.13em] text-accent">
            {copy.meetTag}
          </span>
          <span class="text-sm font-semibold text-muted">
            {lang === 'ru' ? 'Регенсбург' : 'Regensburg'}
          </span>
        </div>
        <h2 class="max-w-3xl font-display text-[clamp(2.1rem,5vw,5.2rem)] leading-[1.03] tracking-[-0.035em]">
          {copy.meetTitle}
          <br />
          {copy.meetPlace}
        </h2>
        <p class="mt-7 max-w-2xl text-lg leading-relaxed text-muted">
          {copy.meetBody}
        </p>
        <button
          id="meet-details-open"
          type="button"
          aria-haspopup="dialog"
          aria-controls="meet-details-dialog"
          class="mt-6 inline-flex min-h-12 items-center rounded-xl border border-brand/20 bg-brand-surface px-5 py-3 font-semibold text-brand transition hover:border-brand hover:bg-brand hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand"
        >
          {copy.meetDetailsLink}
        </button>
        <div class="mt-10 grid max-w-2xl gap-4 sm:grid-cols-2">
          <div class="rounded-3xl bg-brand-surface p-6">
            <p class="text-xs font-bold uppercase tracking-[0.16em] text-muted">
              {copy.when}
            </p>
            <p class="mt-3 font-display text-2xl">{copy.meetDate}</p>
            <p class="mt-2 text-sm text-muted">{copy.meetRegistration}</p>
          </div>
          <div class="rounded-3xl bg-brand-surface p-6">
            <p class="text-xs font-bold uppercase tracking-[0.16em] text-muted">
              {copy.where}
            </p>
            <p class="mt-3 font-display text-2xl">
              {lang === 'ru' ? 'Регенсбург' : 'Regensburg'}
            </p>
            <p class="mt-2 text-sm text-muted">{copy.meetAddress}</p>
          </div>
        </div>
      </div>
      <aside class="min-w-0 self-start overflow-hidden rounded-4xl border border-brand/10 bg-brand-surface shadow-xl lg:sticky lg:top-28">
        <div class="relative flex h-48 items-end overflow-hidden bg-hero-end/60 p-7">
          <div
            aria-hidden="true"
            class="absolute -right-8 -top-16 h-60 w-60 rounded-full border-[2.5rem] border-white/40"
          ></div>
          <div class="relative flex items-end gap-3 text-brand">
            <strong class="font-display text-7xl leading-none">10</strong>
            <span class="pb-2 text-lg font-semibold leading-tight">
              {copy.meetMonth}
              <br />
              2026
            </span>
          </div>
        </div>
        <div class="p-7">
          <p class="text-sm font-semibold text-muted">{copy.meetTicket}</p>
          <p class="mt-2 font-display text-5xl">29 €</p>
          <button
            type="button"
            data-ticket="meetup"
            class="mt-7 w-full rounded-2xl bg-brand px-6 py-4 text-base font-bold text-white transition hover:bg-accent hover:text-brand-gold focus-visible:bg-accent focus-visible:text-brand-gold focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand"
          >
            {copy.buyTicket}
          </button>
          <p class="mt-4 text-center text-xs leading-relaxed text-muted">
            {copy.beforePayment}
          </p>
        </div>
      </aside>
    </div>
  </section>

  <section id="games" class="scroll-mt-24 bg-brand-surface py-18 md:py-26">
    <div class="site-container grid gap-9 lg:grid-cols-[minmax(0,1fr)_360px] lg:gap-14">
      <div class="min-w-0">
        <div class="mb-8 flex flex-wrap items-center gap-3">
          <span class="rounded-full bg-white px-4 py-2 text-xs font-bold uppercase tracking-[0.13em] text-accent">
            {copy.gamesTag}
          </span>
          <span class="text-sm font-semibold text-muted">
            {lang === 'ru' ? 'Мюнхен' : 'München'}
          </span>
        </div>
        <h2 class="max-w-3xl font-display text-[clamp(1.75rem,5vw,5.2rem)] leading-[1.03] tracking-[-0.035em]">
          {copy.gamesTitle}
          <br />
          {copy.gamesPlace}
        </h2>
        <p class="mt-7 max-w-2xl text-lg leading-relaxed text-muted">
          {copy.gamesBody}
        </p>
        <div class="mt-10 grid max-w-2xl gap-4 sm:grid-cols-2">
          <div class="rounded-3xl bg-white/75 p-6">
            <p class="text-xs font-bold uppercase tracking-[0.16em] text-muted">
              {copy.when}
            </p>
            <p class="mt-3 font-display text-2xl">{copy.gamesDate}</p>
            <p class="mt-2 text-sm text-muted">{copy.timeLater}</p>
          </div>
          <div class="rounded-3xl bg-white/75 p-6">
            <p class="text-xs font-bold uppercase tracking-[0.16em] text-muted">
              {copy.where}
            </p>
            <p class="mt-3 font-display text-2xl">{copy.gamesVenue}</p>
            <p class="mt-2 text-sm text-muted">{copy.gamesAddress}</p>
          </div>
        </div>
      </div>
      <aside class="min-w-0 self-start overflow-hidden rounded-4xl border border-brand/10 bg-white shadow-xl lg:sticky lg:top-28">
        <div class="relative flex h-40 items-end overflow-hidden bg-hero-end/60 p-7">
          <div
            aria-hidden="true"
            class="absolute -right-8 -top-16 h-60 w-60 rounded-full border-[2.5rem] border-white/40"
          ></div>
          <div class="relative flex items-end gap-3 text-brand">
            <strong class="font-display text-7xl leading-none">7</strong>
            <span class="pb-2 text-lg font-semibold leading-tight">
              {copy.gamesMonth}
              <br />
              2026
            </span>
          </div>
        </div>
        <div class="p-7">
          <p class="mb-4 text-sm font-semibold text-muted">{copy.role}</p>
          <button
            type="button"
            data-ticket="guest"
            class="mb-3 flex w-full items-center justify-between gap-3 rounded-2xl border border-brand/20 px-5 py-4 text-left transition hover:border-brand hover:bg-brand hover:text-brand-gold focus-visible:bg-brand focus-visible:text-brand-gold focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand"
          >
            <span class="min-w-0">
              <span class="block font-bold">{copy.guest}</span>
              <span
                id="guest-offer-note"
                class:list={[
                  'mt-1 block text-xs leading-snug opacity-80',
                  { hidden: !earlyBirdInitially },
                ]}
              >
                {copy.earlyBirdUntil}
              </span>
            </span>
            <span class="flex shrink-0 items-baseline gap-2 whitespace-nowrap">
              <s
                id="guest-old-price"
                aria-hidden="true"
                class:list={[
                  'text-sm opacity-65',
                  { hidden: !earlyBirdInitially },
                ]}
              >
                99 €
              </s>
              <strong
                id="guest-current-price"
                class="font-display text-2xl font-normal"
              >
                {earlyBirdInitially ? '70 €' : '99 €'}
              </strong>
            </span>
          </button>
          <button
            type="button"
            data-ticket="host"
            class="flex w-full items-center justify-between rounded-2xl border border-brand/20 px-5 py-4 text-left transition hover:border-brand hover:bg-brand hover:text-brand-gold focus-visible:bg-brand focus-visible:text-brand-gold focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand"
          >
            <span class="font-bold">{copy.host}</span>
            <strong class="font-display text-2xl font-normal">249 €</strong>
          </button>
          <p class="mt-4 text-center text-xs leading-relaxed text-muted">
            {copy.roleSaved}
          </p>
        </div>
      </aside>
    </div>
  </section>

  <section class="bg-brand py-16 text-white md:py-20">
    <div class="site-container flex flex-col items-start justify-between gap-8 md:flex-row md:items-center">
      <div>
        <h2 class="font-display text-3xl md:text-4xl">{copy.questions}</h2>
        <p class="mt-3 max-w-xl text-white/75">{copy.questionsBody}</p>
      </div>
      <a
        href={routes.contacts[lang]}
        class="rounded-2xl border border-white/40 px-6 py-4 font-bold transition hover:bg-white hover:text-brand"
      >
        {copy.contactLink}
      </a>
    </div>
  </section>
</div>

<div
  id="payment-return"
  role="status"
  class="fixed inset-x-4 top-4 z-50 mx-auto hidden max-w-md items-start gap-3 rounded-2xl border border-brand/20 bg-white px-4 py-3 text-left text-sm font-semibold leading-relaxed text-brand shadow-lg"
>
  <span id="payment-return-message" class="flex-1"></span>
  <button
    id="payment-return-close"
    type="button"
    aria-label={lang === 'ru' ? 'Закрыть сообщение' : 'Mitteilung schließen'}
    class="-mr-1 -mt-1 flex h-8 w-8 shrink-0 items-center justify-center rounded-full text-2xl font-normal leading-none text-brand transition hover:bg-brand/10 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand"
  >
    ×
  </button>
</div>

<dialog
  id="meet-details-dialog"
  aria-labelledby="meet-details-title"
  class="m-auto h-[calc(100dvh-1rem)] w-[calc(100%-1rem)] max-w-none max-h-[calc(100dvh-1rem)] overflow-hidden rounded-4xl border-0 bg-white p-0 text-brand shadow-2xl backdrop:bg-brand/65 sm:h-auto sm:max-w-[44rem] sm:max-h-[min(88dvh,900px)]"
>
  <div class="flex h-full max-h-[calc(100dvh-1rem)] min-h-0 flex-col sm:max-h-[min(88dvh,900px)]">
    <div class="flex shrink-0 items-start justify-between gap-4 border-b border-brand/10 bg-brand-surface px-5 py-5 sm:px-8 sm:py-6">
      <div class="min-w-0">
        <p class="text-xs font-bold uppercase tracking-[0.16em] text-accent">
          {copy.meetTag}
        </p>
        <h2
          id="meet-details-title"
          class="mt-2 font-display text-2xl leading-tight sm:text-3xl"
        >
          {copy.meetDetailsTitle}
        </h2>
        <p class="mt-2 text-sm text-muted">{copy.meetDate} · 29 €</p>
      </div>
      <button
        id="meet-details-close"
        type="button"
        aria-label={copy.meetDetailsClose}
        class="grid h-11 w-11 shrink-0 place-items-center rounded-full border border-brand bg-white transition hover:bg-hero-end focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand"
      >
        <svg
          aria-hidden="true"
          viewBox="0 0 24 24"
          class="h-4 w-4"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
        >
          <path d="M5 5 19 19M19 5 5 19" />
        </svg>
      </button>
    </div>
    <div class="min-h-0 overflow-y-auto overscroll-contain px-5 py-6 text-base leading-relaxed text-muted sm:px-8 sm:py-8">
      <div class="space-y-4">
        <p class="font-semibold text-brand">{copy.meetDetailsIntro}</p>
        <p>{copy.meetDetailsBody}</p>
        <p>{copy.meetDetailsEnd}</p>
      </div>
      <section class="mt-8" aria-labelledby="meet-schedule-title">
        <h3 id="meet-schedule-title" class="font-display text-2xl text-brand">
          {copy.meetScheduleTitle}
        </h3>
        <ol class="mt-4 divide-y divide-brand/10 rounded-2xl bg-brand-surface px-4 sm:px-6">
          {copy.meetSchedule.map(([time, activity]) => (
            <li class="grid grid-cols-[3.75rem_minmax(0,1fr)] gap-4 py-3 sm:grid-cols-[4.5rem_minmax(0,1fr)]">
              <time class="font-bold text-brand">{time}</time>
              <span>{activity}</span>
            </li>
          ))}
        </ol>
      </section>
      <p class="mt-7">{copy.meetDetailsClosing}</p>
    </div>
    <div class="shrink-0 border-t border-brand/10 bg-white px-5 py-4 sm:px-8">
      <button
        id="meet-details-buy"
        type="button"
        class="w-full rounded-2xl bg-brand px-6 py-4 font-bold text-white transition hover:bg-accent hover:text-brand-gold focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand"
      >
        {copy.meetDetailsBuy}
      </button>
    </div>
  </div>
</dialog>

<dialog
  id="ticket-dialog"
  data-lang={lang}
  aria-labelledby="ticket-title"
  class="m-auto w-[min(calc(100%-2rem),480px)] max-h-[calc(100dvh-2rem)] rounded-4xl border-0 bg-white p-0 text-brand shadow-2xl backdrop:bg-brand/65"
>
  <div class="max-h-[calc(100dvh-2rem)] overflow-y-auto p-6 sm:p-8">
    <div class="flex items-start justify-between gap-6">
      <div>
        <p
          id="ticket-step"
          class="text-xs font-bold uppercase tracking-[0.16em] text-accent"
        >
          {copy.contactStep}
        </p>
        <h2 id="ticket-title" class="mt-3 font-display text-3xl leading-tight">
          {copy.meetTicket}
        </h2>
        <p id="ticket-summary" class="mt-2 text-sm text-muted">
          {copy.meetShort.replace(' ↗', '')} · 29 €
        </p>
      </div>
      <button
        id="ticket-close"
        type="button"
        aria-label={copy.close}
        class="grid h-10 w-10 shrink-0 place-items-center rounded-full border border-brand bg-brand-surface p-0 hover:bg-hero-end"
      >
        <svg
          aria-hidden="true"
          viewBox="0 0 24 24"
          class="h-4 w-4"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
        >
          <path d="M5 5 19 19M19 5 5 19" />
        </svg>
      </button>
    </div>
    <form id="ticket-form" class="mt-7 space-y-5">
      <label class="block">
        <span class="mb-2 block text-sm font-bold">{copy.name}</span>
        <input
          name="name"
          autocomplete="name"
          required
          placeholder={copy.namePlaceholder}
          class="w-full rounded-xl border border-line px-4 py-3 outline-none focus:border-brand focus:ring-2 focus:ring-brand/15"
        />
      </label>
      <fieldset>
        <legend class="mb-2 text-sm font-bold">{copy.channel}</legend>
        <div class="grid grid-cols-3 gap-2 text-center text-sm">
          <label>
            <input
              type="radio"
              name="channel"
              value="Telegram"
              checked
              class="peer sr-only"
            />
            <span class="block cursor-pointer rounded-xl border border-line px-2 py-3 peer-checked:border-brand peer-checked:bg-brand-surface peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-brand">
              Telegram
            </span>
          </label>
          <label>
            <input
              type="radio"
              name="channel"
              value="WhatsApp"
              class="peer sr-only"
            />
            <span class="block cursor-pointer rounded-xl border border-line px-2 py-3 peer-checked:border-brand peer-checked:bg-brand-surface peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-brand">
              WhatsApp
            </span>
          </label>
          <label>
            <input
              type="radio"
              name="channel"
              value="Instagram"
              class="peer sr-only"
            />
            <span class="block cursor-pointer rounded-xl border border-line px-2 py-3 peer-checked:border-brand peer-checked:bg-brand-surface peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-brand">
              Instagram
            </span>
          </label>
        </div>
      </fieldset>
      <fieldset id="whatsapp-type" class="hidden">
        <legend class="mb-2 text-sm font-bold">{copy.whatsappType}</legend>
        <div class="grid grid-cols-2 gap-2 text-center text-sm">
          <label>
            <input
              type="radio"
              name="whatsapp-type"
              value="phone"
              checked
              class="peer sr-only"
            />
            <span class="block cursor-pointer rounded-xl border border-line px-2 py-3 peer-checked:border-brand peer-checked:bg-brand-surface peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-brand">
              {copy.whatsappPhone}
            </span>
          </label>
          <label>
            <input
              type="radio"
              name="whatsapp-type"
              value="username"
              class="peer sr-only"
            />
            <span class="block cursor-pointer rounded-xl border border-line px-2 py-3 peer-checked:border-brand peer-checked:bg-brand-surface peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-brand">
              {copy.whatsappUsername}
            </span>
          </label>
        </div>
      </fieldset>
      <label class="block">
        <span id="contact-label" class="mb-2 block text-sm font-bold">
          {copy.contactLabel}
        </span>
        <input
          name="contact"
          required
          placeholder={copy.contactPlaceholder}
          aria-describedby="contact-hint contact-error"
          aria-invalid="false"
          class="w-full rounded-xl border border-line px-4 py-3 outline-none focus:border-brand focus:ring-2 focus:ring-brand/15"
        />
      </label>
      <p id="contact-hint" class="-mt-3 text-xs leading-relaxed text-muted"></p>
      <p
        id="contact-error"
        role="alert"
        class="-mt-3 hidden text-xs font-semibold leading-relaxed text-red-700"
      ></p>
      <p class="text-xs leading-relaxed text-muted">{copy.contactUse}</p>
      <button
        type="submit"
        class="w-full rounded-2xl bg-brand px-6 py-4 font-bold text-white hover:bg-accent"
      >
        {copy.continue}
      </button>
    </form>
    <div id="ticket-payment" class="mt-7 hidden space-y-3">
      <div class="pb-2 text-center">
        <p class="text-xs font-bold uppercase tracking-[0.16em] text-accent">
          {copy.contactFor}
        </p>
        <p
          id="ticket-person"
          class="mt-1 break-words font-display text-3xl"
        ></p>
        <p
          id="ticket-contact"
          class="mt-1 break-all text-sm font-semibold text-accent"
        ></p>
      </div>
      <label class="flex items-start gap-3 rounded-xl bg-brand-surface p-3 text-xs leading-relaxed text-brand">
        <input
          id="ticket-privacy"
          type="checkbox"
          class="mt-0.5 h-4 w-4 shrink-0"
        />
        <span>
          {copy.termsBefore}{' '}
          <a
            href={routes.terms[lang]}
            target="_blank"
            rel="noopener"
            class="font-semibold underline underline-offset-2"
          >
            {copy.termsLink}
          </a>{' '}
          {copy.privacyBefore}{' '}
          <a
            href={routes.privacy[lang]}
            target="_blank"
            rel="noopener"
            class="font-semibold underline underline-offset-2"
          >
            {copy.privacyLink}
          </a>
          {lang === 'de' ? ' gelesen.' : '.'}
        </span>
      </label>
      <p class="text-sm text-muted">{copy.choosePayment}</p>
      <button
        type="button"
        data-payment="stripe"
        disabled
        class="flex w-full items-center justify-between rounded-2xl border border-line px-5 py-4 text-left font-bold hover:border-brand disabled:cursor-not-allowed disabled:opacity-50"
      >
        {copy.stripe} <span>→</span>
      </button>
      <button
        type="button"
        data-payment="paypal"
        disabled
        class="hidden w-full items-center justify-between rounded-2xl border border-line px-5 py-4 text-left font-bold hover:border-brand disabled:cursor-not-allowed disabled:opacity-50"
      >
        {copy.paypal} <span>→</span>
      </button>
      <p
        id="ticket-error"
        role="alert"
        class="hidden rounded-xl bg-red-50 p-3 text-sm text-red-800"
      ></p>
      <p
        id="ticket-preview-note"
        class="pt-2 text-xs leading-relaxed text-muted"
      >
        {copy.previewNote}
      </p>
      <button
        id="ticket-back"
        type="button"
        class="text-sm font-semibold underline underline-offset-4"
      >
        {copy.back}
      </button>
    </div>
  </div>
</dialog>

<script>
  import { isEarlyBirdActive } from '../lib/early-bird';

  const detailsDialog = document.querySelector<HTMLDialogElement>(
    '#meet-details-dialog',
  );
  const detailsOpen =
    document.querySelector<HTMLButtonElement>('#meet-details-open');
  const detailsClose = document.querySelector<HTMLButtonElement>(
    '#meet-details-close',
  );
  const detailsBuy =
    document.querySelector<HTMLButtonElement>('#meet-details-buy');
  let openingTicketFromDetails = false;
  detailsOpen?.addEventListener('click', () => detailsDialog?.showModal());
  detailsClose?.addEventListener('click', () => detailsDialog?.close());
  detailsDialog?.addEventListener('click', (event) => {
    if (event.target === detailsDialog) detailsDialog.close();
  });
  detailsDialog?.addEventListener('close', () => {
    if (!openingTicketFromDetails) detailsOpen?.focus();
    openingTicketFromDetails = false;
  });
  detailsBuy?.addEventListener('click', () => {
    openingTicketFromDetails = true;
    detailsDialog?.close();
    document
      .querySelector<HTMLButtonElement>('[data-ticket="meetup"]')
      ?.click();
  });

  const dialog = document.querySelector<HTMLDialogElement>('#ticket-dialog');
  const form = document.querySelector<HTMLFormElement>('#ticket-form');
  const payment = document.querySelector<HTMLElement>('#ticket-payment');
  const step = document.querySelector<HTMLElement>('#ticket-step');
  const title = document.querySelector<HTMLElement>('#ticket-title');
  const summary = document.querySelector<HTMLElement>('#ticket-summary');
  const contactLabel = document.querySelector<HTMLElement>('#contact-label');
  const contactInput = form?.querySelector<HTMLInputElement>(
    'input[name="contact"]',
  );
  const nameInput = form?.querySelector<HTMLInputElement>('input[name="name"]');
  const contactHint = document.querySelector<HTMLElement>('#contact-hint');
  const contactError = document.querySelector<HTMLElement>('#contact-error');
  const whatsappType = document.querySelector<HTMLElement>('#whatsapp-type');
  const privacy = document.querySelector<HTMLInputElement>('#ticket-privacy');
  const previewNote = document.querySelector<HTMLElement>(
    '#ticket-preview-note',
  );
  const noteRu = dialog?.dataset.lang === 'ru';
  const guestButton = document.querySelector<HTMLButtonElement>(
    '[data-ticket="guest"]',
  );
  const guestCurrentPrice = document.querySelector<HTMLElement>(
    '#guest-current-price',
  );
  const guestOldPrice = document.querySelector<HTMLElement>('#guest-old-price');
  const guestOfferNote =
    document.querySelector<HTMLElement>('#guest-offer-note');
  let serverClockOffsetMs = 0;
  const effectiveNow = () => Date.now() + serverClockOffsetMs;
  const refreshGuestOffer = () => {
    const early = isEarlyBirdActive(effectiveNow());
    if (guestCurrentPrice)
      guestCurrentPrice.textContent = early ? '70 €' : '99 €';
    guestOldPrice?.classList.toggle('hidden', !early);
    guestOfferNote?.classList.toggle('hidden', !early);
    guestButton?.setAttribute(
      'aria-label',
      noteRu
        ? early
          ? 'Я участник. Ранняя цена 70 евро до 15 октября, затем 99 евро'
          : 'Я участник. Цена 99 евро'
        : early
          ? 'Ich nehme teil. Frühbucherpreis 70 Euro bis 15. Oktober, danach 99 Euro'
          : 'Ich nehme teil. Preis 99 Euro',
    );
  };
  refreshGuestOffer();
  window.setInterval(refreshGuestOffer, 30_000);
  document.addEventListener('visibilitychange', () => {
    if (!document.hidden) refreshGuestOffer();
  });
  let paymentsEnabled = false;
  let providers = { stripe: false, paypal: false };
  const paymentButtons =
    document.querySelectorAll<HTMLButtonElement>('[data-payment]');
  const refreshPaymentButtons = () => {
    paymentButtons.forEach((button) => {
      const provider = button.dataset.payment as 'stripe' | 'paypal';
      if (provider === 'paypal') {
        button.classList.toggle('hidden', !providers.paypal);
        button.classList.toggle('flex', providers.paypal);
      }
      button.disabled = !privacy?.checked || !providers[provider];
    });
  };
  fetch('/api/config')
    .then(
      (r) =>
        (r.ok ? r.json() : null) as Promise<{
          paymentsEnabled?: boolean;
          mode?: string;
          stripe?: boolean;
          paypal?: boolean;
          serverTime?: number;
        } | null>,
    )
    .then((cfg) => {
      if (typeof cfg?.serverTime === 'number') {
        serverClockOffsetMs = cfg.serverTime - Date.now();
        refreshGuestOffer();
      }
      paymentsEnabled = !!cfg?.paymentsEnabled;
      providers = {
        stripe: cfg?.stripe ?? paymentsEnabled,
        paypal: cfg?.paypal === true,
      };
      if (previewNote) {
        if (!paymentsEnabled)
          previewNote.textContent = noteRu
            ? 'Онлайн-оплата пока недоступна. Напишите нам, и мы всё оформим.'
            : 'Online-Zahlung derzeit nicht verfügbar. Schreiben Sie uns, wir kümmern uns darum.';
        else if (cfg?.mode === 'test')
          previewNote.textContent = noteRu
            ? 'Тестовый режим оплаты. Настоящие деньги не списываются.'
            : 'Testmodus für Zahlungen. Es wird kein echtes Geld abgebucht.';
        else if (providers.paypal)
          previewNote.textContent = noteRu
            ? 'Оплата проходит на защищённой странице Stripe или PayPal.'
            : 'Die Zahlung erfolgt auf der gesicherten Seite von Stripe oder PayPal.';
      }
      refreshPaymentButtons();
    })
    .catch(() => {});
  const errorBox = document.querySelector<HTMLElement>('#ticket-error');
  let currentTicket = '';
  const person = document.querySelector<HTMLElement>('#ticket-person');
  const shownContact = document.querySelector<HTMLElement>('#ticket-contact');
  const isRu = dialog?.dataset.lang === 'ru';
  const contactStep = isRu
    ? 'Шаг 1 из 2 · Контакт'
    : 'Schritt 1 von 2 · Kontakt';
  const paymentStep = isRu
    ? 'Шаг 2 из 2 · Оплата'
    : 'Schritt 2 von 2 · Zahlung';
  const tickets = isRu
    ? {
        meetup: ['Билет на встречу', '10 октября · Регенсбург · 29 €'],
        guest_early: ['Билет участника', '7 ноября · Мюнхен · 70 €'],
        guest: ['Билет участника', '7 ноября · Мюнхен · 99 €'],
        host: ['Билет ведущего игр', '7 ноября · Мюнхен · 249 €'],
      }
    : {
        meetup: ['Ticket für das Treffen', '10. Oktober · Regensburg · 29 €'],
        guest_early: [
          'Ticket für Teilnehmende',
          '7. November · München · 70 €',
        ],
        guest: ['Ticket für Teilnehmende', '7. November · München · 99 €'],
        host: ['Ticket für Spielleitende', '7. November · München · 249 €'],
      };

  const selectedChannel = () =>
    form?.querySelector<HTMLInputElement>('input[name="channel"]:checked')
      ?.value || 'Telegram';
  const selectedWhatsAppType = () =>
    form?.querySelector<HTMLInputElement>('input[name="whatsapp-type"]:checked')
      ?.value || 'phone';
  const contactMode = () =>
    selectedChannel() === 'WhatsApp'
      ? `WhatsApp-${selectedWhatsAppType()}`
      : selectedChannel();

  const contactCopy = {
    Telegram: {
      label: isRu ? 'Ваш аккаунт в Telegram' : 'Dein Telegram-Benutzername',
      placeholder: '@username',
      hint: isRu
        ? 'Латинские буквы, цифры и _. @ можно не писать.'
        : 'Lateinische Buchstaben, Ziffern und _. @ ist optional.',
      error: isRu
        ? 'Введите имя Telegram латиницей: 5–27 букв, цифр или _. Первым символом должна быть буква.'
        : 'Bitte gib einen Telegram-Namen mit 5–27 lateinischen Buchstaben, Ziffern oder _ ein. Er muss mit einem Buchstaben beginnen.',
      maxLength: 28,
      inputMode: 'text',
    },
    Instagram: {
      label: isRu ? 'Ваш аккаунт в Instagram' : 'Dein Instagram-Benutzername',
      placeholder: '@username',
      hint: isRu
        ? 'Латинские буквы, цифры, точки и _. @ можно не писать.'
        : 'Lateinische Buchstaben, Ziffern, Punkte und _. @ ist optional.',
      error: isRu
        ? 'Введите имя Instagram латиницей: до 30 букв, цифр, точек или _.'
        : 'Bitte gib einen Instagram-Namen mit bis zu 30 lateinischen Buchstaben, Ziffern, Punkten oder _ ein.',
      maxLength: 31,
      inputMode: 'text',
    },
    'WhatsApp-phone': {
      label: isRu ? 'Ваш номер в WhatsApp' : 'Deine WhatsApp-Nummer',
      placeholder: isRu
        ? '+49 176 12345678 или 0176 12345678'
        : '+49 176 12345678 oder 0176 12345678',
      hint: isRu
        ? 'Номер с + и кодом страны или немецкий номер с 0.'
        : 'Mit + und Ländervorwahl oder als deutsche Nummer mit 0.',
      error: isRu
        ? 'Проверьте номер: например, +49 176 12345678 или 0176 12345678.'
        : 'Prüfe die Nummer: zum Beispiel +49 176 12345678 oder 0176 12345678.',
      maxLength: 24,
      inputMode: 'tel',
    },
    'WhatsApp-username': {
      label: isRu
        ? 'Ваше имя пользователя WhatsApp'
        : 'Dein WhatsApp-Benutzername',
      placeholder: '@username',
      hint: isRu
        ? 'Имя пользователя доступно в WhatsApp постепенно. Проверьте, что у вас оно уже работает.'
        : 'WhatsApp-Benutzernamen werden schrittweise eingeführt. Prüfe, ob deiner bereits funktioniert.',
      error: isRu
        ? 'Введите имя пользователя латиницей, без пробелов и русских букв.'
        : 'Bitte gib einen Benutzernamen mit lateinischen Zeichen ein, ohne Leerzeichen.',
      maxLength: 31,
      inputMode: 'text',
    },
  } as const;

  const clearContactError = () => {
    if (!contactInput || !contactError || !contactHint) return;
    contactInput.setCustomValidity('');
    contactInput.setAttribute('aria-invalid', 'false');
    contactError.textContent = '';
    contactError.classList.add('hidden');
    contactHint.classList.remove('hidden');
  };

  const validateContact = (showError: boolean) => {
    if (!contactInput) return false;
    const mode = contactMode();
    const value = contactInput.value.trim();
    const username = value.replace(/^@/, '');
    let valid = false;
    if (mode === 'Telegram')
      valid = /^[A-Za-z][A-Za-z0-9_]{4,26}$/.test(username);
    if (mode === 'Instagram')
      valid =
        /^[A-Za-z0-9_][A-Za-z0-9._]{0,29}$/.test(username) &&
        !username.endsWith('.') &&
        !username.includes('..');
    if (mode === 'WhatsApp-username')
      valid = /^[A-Za-z0-9_][A-Za-z0-9._]{2,29}$/.test(username);
    if (mode === 'WhatsApp-phone') {
      const number = value.replace(/[\s()-]/g, '');
      valid = /^\+[1-9]\d{9,14}$/.test(number) || /^0\d{8,13}$/.test(number);
    }
    if (valid || !value) {
      clearContactError();
      return valid;
    }
    if (showError && contactError) {
      const message = contactCopy[mode as keyof typeof contactCopy].error;
      contactInput.setCustomValidity(message);
      contactInput.setAttribute('aria-invalid', 'true');
      contactError.textContent = message;
      contactError.classList.remove('hidden');
      contactHint?.classList.add('hidden');
    }
    return false;
  };

  const updateContactMode = () => {
    if (!contactInput || !contactLabel || !contactHint || !whatsappType) return;
    const mode = contactMode();
    const config = contactCopy[mode as keyof typeof contactCopy];
    whatsappType.classList.toggle('hidden', selectedChannel() !== 'WhatsApp');
    contactLabel.textContent = config.label;
    contactInput.placeholder = config.placeholder;
    contactInput.maxLength = config.maxLength;
    contactInput.inputMode = config.inputMode;
    contactHint.textContent = config.hint;
    contactInput.value = '';
    clearContactError();
  };

  updateContactMode();

  document
    .querySelectorAll<HTMLButtonElement>('[data-ticket]')
    .forEach((button) => {
      button.addEventListener('click', () => {
        refreshGuestOffer();
        const selectedTicket =
          button.dataset.ticket === 'guest' && isEarlyBirdActive(effectiveNow())
            ? 'guest_early'
            : button.dataset.ticket;
        const ticket = tickets[selectedTicket as keyof typeof tickets];
        if (
          !dialog ||
          !ticket ||
          !title ||
          !summary ||
          !step ||
          !form ||
          !payment
        )
          return;
        currentTicket = selectedTicket || '';
        errorBox?.classList.add('hidden');
        title.textContent = ticket[0];
        summary.textContent = ticket[1];
        step.textContent = contactStep;
        form.classList.remove('hidden');
        payment.classList.add('hidden');
        form.reset();
        if (privacy) privacy.checked = false;
        paymentButtons.forEach((button) => (button.disabled = true));
        updateContactMode();
        dialog.showModal();
      });
    });
  document
    .querySelector('#ticket-close')
    ?.addEventListener('click', () => dialog?.close());
  dialog?.addEventListener('click', (event) => {
    if (event.target === dialog) dialog.close();
  });
  form
    ?.querySelectorAll<HTMLInputElement>(
      'input[name="channel"], input[name="whatsapp-type"]',
    )
    .forEach((radio) => {
      radio.addEventListener('change', updateContactMode);
    });
  contactInput?.addEventListener('input', () => validateContact(true));
  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    validateContact(true);
    if (
      !form.reportValidity() ||
      !payment ||
      !step ||
      !person ||
      !shownContact ||
      !nameInput ||
      !contactInput
    )
      return;
    const contact = contactInput.value.trim();
    const mode = contactMode();
    const normalizedContact =
      mode === 'WhatsApp-phone'
        ? (() => {
            const digits = contact.replace(/[\s()-]/g, '');
            return digits.startsWith('0') ? `+49${digits.slice(1)}` : digits;
          })()
        : contact;
    person.textContent = nameInput.value.trim();
    shownContact.textContent = `${selectedChannel()} · ${mode === 'WhatsApp-phone' ? normalizedContact : `@${contact.replace(/^@/, '')}`}`;
    form.classList.add('hidden');
    payment.classList.remove('hidden');
    step.textContent = paymentStep;
    privacy?.focus();
  });
  privacy?.addEventListener('change', () => {
    refreshPaymentButtons();
  });
  const orderErrors = isRu
    ? {
        disabled:
          'Онлайн-оплата пока недоступна. Напишите нам, и мы всё оформим.',
        generic:
          'Не удалось перейти к оплате. Попробуйте ещё раз или напишите нам.',
        offerEnded:
          'Ранняя цена закончилась. Билет участника теперь стоит 99 €. Проверьте сумму и нажмите оплату ещё раз.',
      }
    : {
        disabled:
          'Die Online-Zahlung ist noch nicht verfügbar. Schreib uns, wir regeln es.',
        generic:
          'Weiterleitung zur Zahlung fehlgeschlagen. Bitte versuche es erneut oder schreib uns.',
        offerEnded:
          'Der Frühbucherpreis ist abgelaufen. Das Ticket für Teilnehmende kostet jetzt 99 €. Bitte prüfe den Preis und starte die Zahlung erneut.',
      };
  const showOfferEnded = () => {
    currentTicket = 'guest';
    if (summary) summary.textContent = tickets.guest[1];
    refreshGuestOffer();
    if (errorBox) {
      errorBox.textContent = orderErrors.offerEnded;
      errorBox.classList.remove('hidden');
    }
    refreshPaymentButtons();
  };
  paymentButtons.forEach((button) =>
    button.addEventListener('click', async (event) => {
      const button = event.currentTarget as HTMLButtonElement;
      const provider = button.dataset.payment as 'stripe' | 'paypal';
      if (!currentTicket || !nameInput || !contactInput || !privacy?.checked)
        return;
      if (
        currentTicket === 'guest_early' &&
        !isEarlyBirdActive(effectiveNow())
      ) {
        showOfferEnded();
        return;
      }
      errorBox?.classList.add('hidden');
      button.disabled = true;
      let message = orderErrors.generic;
      try {
        const response = await fetch('/api/orders', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            ticket: currentTicket,
            name: nameInput.value.trim(),
            channel: contactMode(),
            contact: contactInput.value.trim(),
            lang: isRu ? 'ru' : 'de',
            consent: true,
            provider,
          }),
        });
        const data: unknown = await response.json().catch(() => ({}));
        if (
          response.ok &&
          typeof data === 'object' &&
          data !== null &&
          'url' in data &&
          typeof data.url === 'string'
        ) {
          location.href = data.url;
          return;
        }
        if (
          response.status === 409 &&
          typeof data === 'object' &&
          data !== null &&
          'error' in data &&
          data.error === 'offer_ended'
        ) {
          if ('serverTime' in data && typeof data.serverTime === 'number')
            serverClockOffsetMs = data.serverTime - Date.now();
          showOfferEnded();
          return;
        }
        if (response.status === 403 || response.status === 503)
          message = orderErrors.disabled;
      } catch {
        /* network error: generic message */
      }
      if (errorBox) {
        errorBox.textContent = message;
        errorBox.classList.remove('hidden');
      }
      refreshPaymentButtons();
    }),
  );
  const returned = new URLSearchParams(location.search).get('payment');
  const returnBox = document.querySelector<HTMLElement>('#payment-return');
  const returnMessage = document.querySelector<HTMLElement>(
    '#payment-return-message',
  );
  document
    .querySelector('#payment-return-close')
    ?.addEventListener('click', () => {
      returnBox?.classList.add('hidden');
      returnBox?.classList.remove('flex');
    });
  if (
    returnBox &&
    returnMessage &&
    (returned === 'success' || returned === 'cancelled' || returned === 'error')
  ) {
    returnMessage.textContent =
      returned === 'success'
        ? isRu
          ? 'Спасибо! Проверяем подтверждение оплаты. После подтверждения свяжемся с вами.'
          : 'Danke! Wir prüfen die Zahlungsbestätigung und melden uns danach bei dir.'
        : returned === 'error'
          ? isRu
            ? 'Не удалось подтвердить оплату. Если деньги списались, напишите нам — мы проверим платёж.'
            : 'Die Zahlung konnte nicht bestätigt werden. Falls Geld abgebucht wurde, schreib uns bitte.'
          : isRu
            ? 'Оплата отменена. Билет не оформлен, деньги не списаны.'
            : 'Zahlung abgebrochen. Es wurde nichts berechnet.';
    returnBox.classList.remove('hidden');
    returnBox.classList.add('flex');
    history.replaceState(null, '', location.pathname);
    setTimeout(() => {
      returnBox.classList.add('hidden');
      returnBox.classList.remove('flex');
    }, 12000);
  }
  document.querySelector('#ticket-back')?.addEventListener('click', () => {
    form?.classList.remove('hidden');
    payment?.classList.add('hidden');
    if (step) step.textContent = contactStep;
    form?.querySelector<HTMLInputElement>('input[name="name"]')?.focus();
  });
</script>
