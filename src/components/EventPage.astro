---

<div class="font-hero-sans text-brand">
  <section class="hero hero--events" aria-labelledby="hero-title">
    <div class="hero__inner site-container">
      <PageIntro class="hero__content">
        <p class="hero__eyebrow">{copy.eyebrow}</p>
        <Heading as="h1" variant="page" class="hero__title" id="hero-title">
          {copy.title}
          <br />
          <span class="text-accent">R.O.S.T.</span>
        </Heading>
        <p class="hero__description">{copy.intro}</p>
        <div class="hero__links">
          <Button variant="secondary" size="compact" href="#games">
            {copy.gamesShort}
          </Button>
          <Button variant="secondary" size="compact" href="#nuremberg">
            {copy.meetShort}
          </Button>
        </div>
      </PageIntro>
      <VideoFacade lang={lang} page="events" />
    </div>
  </section>

  <section id="games" class="ui-section scroll-mt-24 bg-brand-surface">
    <div class="site-container grid gap-9 lg:grid-cols-[minmax(0,1fr)_360px] lg:gap-14">
      <div class="min-w-0">
        <div class="mb-8 flex flex-wrap items-center gap-3">
          <span class="ui-eyebrow rounded-full bg-white px-4 py-2 text-accent">
            {copy.gamesTag}
          </span>
          <span class="text-sm font-semibold text-muted">
            {lang === 'ru' ? 'Мюнхен' : 'München'}
          </span>
        </div>
        <Heading as="h2" variant="section" class="max-w-3xl">
          {copy.gamesTitle}
          <br />
          {copy.gamesPlace}
        </Heading>
        <p class="mt-7 max-w-2xl text-lg leading-relaxed text-muted">
          {copy.gamesBody}
        </p>
        <div class="mt-10 grid max-w-2xl gap-4 sm:grid-cols-2">
          <div class="rounded-3xl bg-white/75 p-6">
            <p class="ui-eyebrow text-muted">{copy.when}</p>
            <p class="mt-3 font-display text-2xl">{copy.gamesDate}</p>
            <p class="mt-2 text-sm text-muted">{copy.timeLater}</p>
          </div>
          <div class="rounded-3xl bg-white/75 p-6">
            <p class="ui-eyebrow text-muted">{copy.where}</p>
            <p class="mt-3 font-display text-2xl">{copy.gamesVenue}</p>
            <p class="mt-2 text-sm text-muted">{copy.gamesAddress}</p>
          </div>
        </div>
        <Button
          variant="secondary"
          size="compact"
          id="games-details-open"
          href={routes.tiGames[lang]}
          class="mt-6"
        >
          {copy.gamesDetailsLink}
        </Button>
      </div>
      <aside class="min-w-0 self-start overflow-hidden rounded-4xl border border-brand/10 bg-white shadow-xl lg:sticky lg:top-28">
        <div class="bg-hero-end px-7 py-5 text-brand">
          <p class="ui-eyebrow">{copy.when}</p>
          <p class="mt-3 font-display text-3xl">{copy.gamesDate}</p>
        </div>
        <div class="p-7">
          <p class="text-sm text-muted">
            {copy.gamesVenue} · Perchtinger Straße 12
          </p>
          <fieldset class="mt-5">
            <legend class="mb-3 font-bold">{copy.chooseTicket}</legend>
            <div class="space-y-3">
              <label class="ui-choice-card flex min-h-24 items-start gap-3">
                <input
                  type="radio"
                  name="events-games-ticket"
                  value="guest"
                  class="mt-1 h-4 w-4 shrink-0 accent-brand"
                />
                <span class="min-w-0 flex-1">
                  <strong class="block text-sm">{copy.basicTicket}</strong>
                  <span class="mt-1 block text-xs leading-snug text-muted">
                    {copy.basicIncludes}
                  </span>
                </span>
                <strong class="shrink-0 font-display text-2xl font-normal">
                  €80
                </strong>
              </label>
              <label class="ui-choice-card flex min-h-24 items-start gap-3">
                <input
                  type="radio"
                  name="events-games-ticket"
                  value="guest_peak"
                  checked
                  class="mt-1 h-4 w-4 shrink-0 accent-brand"
                />
                <span class="min-w-0 flex-1">
                  <strong class="block text-sm">{copy.peakTicket}</strong>
                  <span class="mt-1 block text-xs leading-snug text-muted">
                    {copy.peakIncludes}
                  </span>
                </span>
                <strong class="shrink-0 font-display text-2xl font-normal">
                  €180
                </strong>
              </label>
            </div>
          </fieldset>
          <Button
            variant="primary"
            size="regular"
            type="button"
            data-ticket="guest"
            data-ticket-group="events-games-ticket"
            class="mt-3 w-full"
          >
            {copy.gamesDetailsBuy}
          </Button>
          <Button
            variant="secondary"
            size="compact"
            href={routes.host[lang]}
            class="mt-3 w-full"
          >
            <span>{copy.host}</span>
            <span aria-hidden="true">→</span>
          </Button>
        </div>
      </aside>
    </div>
  </section>

  <section id="nuremberg" class="ui-section scroll-mt-24 bg-white">
    <div class="site-container grid gap-9 lg:grid-cols-[minmax(0,1fr)_360px] lg:gap-14">
      <div class="min-w-0">
        <div class="mb-8 flex flex-wrap items-center gap-3">
          <span class="ui-eyebrow rounded-full bg-brand-surface px-4 py-2 text-accent">
            {copy.meetTag}
          </span>
          <span class="text-sm font-semibold text-muted">
            {lang === 'ru' ? 'Нюрнберг' : 'Nürnberg'}
          </span>
        </div>
        <Heading as="h2" variant="section" class="max-w-3xl">
          {copy.meetTitle}
          <br />
          {copy.meetPlace}
        </Heading>
        <p class="mt-7 max-w-2xl text-lg leading-relaxed text-muted">
          {copy.meetBody}
        </p>
        <div class="mt-10 grid max-w-2xl gap-4 sm:grid-cols-2">
          <div class="rounded-3xl bg-brand-surface p-6">
            <p class="ui-eyebrow text-muted">{copy.when}</p>
            <p class="mt-3 font-display text-2xl">{copy.meetDate}</p>
            <p class="mt-2 text-sm text-muted">{copy.meetRegistration}</p>
          </div>
          <div class="rounded-3xl bg-brand-surface p-6">
            <p class="ui-eyebrow text-muted">{copy.where}</p>
            <p class="mt-3 font-display text-2xl">
              {lang === 'ru' ? 'Нюрнберг' : 'Nürnberg'}
            </p>
            <p class="mt-2 text-sm text-muted">{copy.meetAddress}</p>
          </div>
        </div>
        <Button
          variant="secondary"
          size="compact"
          id="meet-details-open"
          type="button"
          aria-haspopup="dialog"
          aria-controls="meet-details-dialog"
          class="mt-6"
        >
          {copy.meetDetailsLink}
        </Button>
      </div>
      <aside class="min-w-0 self-start overflow-hidden rounded-4xl border border-brand/10 bg-brand-surface shadow-xl lg:sticky lg:top-28">
        <div class="relative flex h-48 items-end overflow-hidden bg-hero-end/60 p-7">
          <div
            aria-hidden="true"
            class="absolute -right-8 -top-16 h-60 w-60 rounded-full border-[2.5rem] border-white/40"
          ></div>
          <div class="relative flex items-end gap-3 text-brand">
