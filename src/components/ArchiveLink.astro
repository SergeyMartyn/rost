---
import Button from './ui/Button.astro';
import { routes, type Language } from '../lib/site';

const { lang } = Astro.props as { lang: Language };
const copy =
  lang === 'ru'
    ? {
        eyebrow: 'ПРОШЕДШИЕ ВСТРЕЧИ',
        description: 'Посмотрите, как проходили наши встречи.',
        link: 'Архив мероприятий →',
      }
    : {
        eyebrow: 'VERGANGENE TREFFEN',
        description: 'Schau dir an, wie unsere Treffen waren.',
        link: 'Veranstaltungsarchiv →',
      };
---

<section class="bg-brand-surface font-hero-sans text-brand">
  <div class="site-container grid gap-7 py-12 md:gap-8 md:py-10 lg:min-h-56 lg:grid-cols-[minmax(0,1fr)_300px] lg:items-center lg:py-8">
    <div>
      <p class="ui-eyebrow">{copy.eyebrow}</p>
      <p class="mt-4 max-w-3xl text-[clamp(1.3rem,2.2vw,1.625rem)] leading-snug">
        {copy.description}
      </p>
    </div>
    <Button
      variant="primary"
      size="regular"
      href={routes.archive[lang]}
      class="mx-auto w-full max-w-[300px] lg:mx-0"
    >
      {copy.link}
    </Button>
  </div>
</section>
