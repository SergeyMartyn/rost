---
import type { Language } from '../lib/site';

const { lang } = Astro.props as { lang: Language };

const copy =
  lang === 'ru'
    ? {
        eyebrow: 'Команда',
        heading: 'Люди, которые делают',
        description: [
          'За каждой встречей стоят люди.',
          'Мы придумываем поводы собраться, продумываем детали и создаём атмосферу, в которой легко знакомиться и хочется увидеться снова.',
        ],
        people: [
          {
            name: 'Кристина Бауэр',
            role: 'Вдохновительница, ведущая',
            image: '/images/team/kristina.webp',
          },
          {
            name: 'Тимур Черепанов',
            role: 'Ведущий встреч, фотограф',
            image: '/images/team/timur.webp',
          },
          {
            name: 'Максим Бурлаков',
            role: 'Организует наши выходные',
            image: '/images/team/maksim.webp',
          },
          {
            name: 'Маргарита Мартын',
            role: 'Менеджер проектов',
            image: '/images/team/margo.webp',
          },
          {
            name: 'Сергей Мартын',
            role: 'Сайт, маркетинг, реклама',
            image: '/images/team/sergey.webp',
          },
        ],
        caption: [
          'У каждого из нас свой опыт и взгляд.',
          'Нас объединяет желание помогать людям находить друг друга —',
          'для разговора, дружбы, новых совместных идей.',
        ],
        list: 'Участники команды R.O.S.T.',
      }
    : {
        eyebrow: 'Team',
        heading: 'Die Menschen hinter',
        description: [
          'Hinter jedem Treffen stehen Menschen.',
          'Wir finden Anlässe, zusammenzukommen, kümmern uns um die Details und schaffen eine Atmosphäre, in der neue Bekanntschaften leichtfallen und man sich gern wiedersieht.',
        ],
        people: [
          {
            name: 'Kristina Bauer',
            role: 'Ideengeberin, Gastgeberin',
            image: '/images/team/kristina.webp',
          },
          {
            name: 'Timur Cherepanov',
            role: 'Gastgeber, Fotograf',
            image: '/images/team/timur.webp',
          },
          {
            name: 'Maksim Burlakov',
            role: 'Plant unsere gemeinsamen Wochenenden',
            image: '/images/team/maksim.webp',
          },
          {
            name: 'Margarita Martyn',
            role: 'Projektmanagerin',
            image: '/images/team/margo.webp',
          },
          {
            name: 'Sergey Martyn',
            role: 'Website, Marketing, Werbung',
            image: '/images/team/sergey.webp',
          },
        ],
        caption: [
          'Jeder von uns bringt eigene Erfahrungen und Perspektiven mit.',
          'Uns verbindet der Wunsch, Menschen zusammenzubringen —',
          'für Gespräche, Freundschaften und neue gemeinsame Ideen.',
        ],
        list: 'Das Team von R.O.S.T.',
      };
---

<section class="team" aria-labelledby="team-title">
  <div class="site-container">
    <p class="team__eyebrow">{copy.eyebrow}</p>
    <div class="team__intro">
      <h2 class="team__heading" id="team-title">
        {copy.heading} <span class="team__brand">R.O.S.T.</span>
      </h2>
      <p class="team__description">
        {copy.description[0]}
        <br />
        {copy.description[1]}
      </p>
    </div>

    <ul class="team__people" aria-label={copy.list}>
      {copy.people.map((person) => (
        <li class="team__person">
          <div class="team__portrait" aria-hidden="true">
            <img
              src={person.image}
              alt=""
              width="512"
              height="512"
              loading="eager"
              decoding="async"
            />
          </div>
          <h3 class="team__name">{person.name}</h3>
          <p class="team__role">{person.role}</p>
        </li>
      ))}
    </ul>

    <p class="team__caption">
      {copy.caption[0]}
      <br />
      {copy.caption[1]}
      <br />
      {copy.caption[2]}
    </p>
  </div>
</section>
