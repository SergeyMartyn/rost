---
import { routes, type Language } from '../lib/site';

const { lang } = Astro.props as { lang: Language };

const copy =
  lang === 'ru'
    ? {
        heading: 'Ближайшие мероприятия',
        value: [
          'Мы предлагаем вам хорошее окружение,',
          'а также повод встретиться снова.',
        ],
        events: [
          {
            name: 'Встреча-знакомство в Регенсбурге',
            date: '10 октября 2026',
            datetime: '2026-10-10',
            anchor: 'regensburg',
            photoAlt: 'Участники встречи на общей фотографии',
            openPhoto: 'Открыть фотографию встречи целиком',
          },
          {
            name: 'Трансформационные игры в Мюнхене',
            date: '7 ноября 2026',
            datetime: '2026-11-07',
            anchor: 'games',
            photoAlt: 'Участники трансформационной игры за столом',
            openPhoto: 'Открыть фотографию игры целиком',
          },
        ],
      }
    : {
        heading: 'Nächste Veranstaltungen',
        value: [
          'Wir bieten dir ein gutes Umfeld',
          'und einen Anlass, dich wiederzusehen.',
        ],
        events: [
          {
            name: 'Kennenlerntreffen in Regensburg',
            date: '10. Oktober 2026',
            datetime: '2026-10-10',
            anchor: 'regensburg',
            photoAlt: 'Teilnehmende des Treffens auf einem Gruppenfoto',
            openPhoto: 'Foto des Treffens vollständig öffnen',
          },
          {
            name: 'Transformationsspiele in München',
            date: '7. November 2026',
            datetime: '2026-11-07',
            anchor: 'games',
            photoAlt: 'Teilnehmende bei einem Transformationsspiel am Tisch',
            openPhoto: 'Foto des Spiels vollständig öffnen',
          },
        ],
      };
const photos = [
  {
    preview: '/images/rost-networking-preview.webp',
    full: '/images/rost-networking.png',
    width: 1920,
    height: 1080,
  },
  {
    preview: '/images/rost-ti-preview.webp',
    full: '/images/rost-ti.jpg',
    width: 3840,
    height: 2555,
  },
];
---

<section class="events" aria-labelledby="events-title">
  <div class="events__inner site-container">
    <div class="events__intro">
      <h2 class="events__heading" id="events-title">
        {copy.heading}
      </h2>
      <p class="events__value">
        {copy.value.map((line) => (
          <span>{line}</span>
        ))}
      </p>
    </div>

    <div class="events__grid">
      {copy.events.map((event, index) => (
        <article class="events__item">
          <button
            class:list={[
              'events__frame',
              'events__photo-trigger',
              { 'events__frame--game': index === 1 },
            ]}
            type="button"
            data-photo-full={photos[index].full}
            data-photo-alt={event.photoAlt}
            aria-label={event.openPhoto}
          >
            <div
              class:list={[
                'events__photo',
                { 'events__photo--networking': index === 0 },
              ]}
            >
              <img
                src={photos[index].preview}
                alt=""
                width={photos[index].width}
                height={photos[index].height}
                loading="lazy"
                decoding="async"
              />
            </div>
            <span class="events__plus" aria-hidden="true">
              +
            </span>
          </button>
          <a
            class="events__link"
            href={`${routes.events[lang]}#${event.anchor}`}
          >
            <h3 class="events__name">{event.name}</h3>
            <time class="events__date" datetime={event.datetime}>
              {event.date}
            </time>
          </a>
        </article>
      ))}
    </div>
  </div>
</section>

<dialog
  id="event-photo-dialog"
  class="events__lightbox"
  aria-label={lang === 'ru' ? 'Фотография мероприятия' : 'Veranstaltungsfoto'}
>
  <div class="events__lightbox-content">
    <button
      class="events__lightbox-close"
      type="button"
      aria-label={lang === 'ru' ? 'Закрыть фотографию' : 'Foto schließen'}
    >
      <svg
        aria-hidden="true"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
      >
        <path d="M5 5 19 19M19 5 5 19" />
      </svg>
    </button>
    <img id="event-photo-full" alt="" />
  </div>
</dialog>

<script>
  const photoDialog = document.querySelector<HTMLDialogElement>(
    '#event-photo-dialog',
  );
  const fullPhoto =
    document.querySelector<HTMLImageElement>('#event-photo-full');

  document
    .querySelectorAll<HTMLButtonElement>('[data-photo-full]')
    .forEach((button) => {
      button.addEventListener('click', () => {
        if (!photoDialog || !fullPhoto || !button.dataset.photoFull) return;
        fullPhoto.src = button.dataset.photoFull;
        fullPhoto.alt = button.dataset.photoAlt || '';
        photoDialog.showModal();
      });
    });

  photoDialog
    ?.querySelector('.events__lightbox-close')
    ?.addEventListener('click', () => photoDialog.close());
  photoDialog?.addEventListener('click', (event) => {
    if (event.target === photoDialog) photoDialog.close();
  });
  photoDialog?.addEventListener('close', () => {
    if (fullPhoto) fullPhoto.removeAttribute('src');
  });
</script>
