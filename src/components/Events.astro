---
import Heading from './ui/Heading.astro';
import { routes, type Language } from '../lib/site';

const { lang } = Astro.props as { lang: Language };

const copy =
  lang === 'ru'
    ? {
        heading: 'Ближайшие мероприятия',
        value: [
          'Мы предлагаем вам хорошее окружение,',
          'а также повод встретиться снова.',
        ],
        events: [
          {
            name: 'Трансформационные игры в Мюнхене',
            date: '7 ноября 2026',
            datetime: '2026-11-07',
            anchor: 'games',
            photoAlt: 'Участники трансформационной игры за столом',
            openPhoto: 'Открыть фотографию игры целиком',
          },
          {
            name: 'Встреча-знакомство и рождественский рынок в Нюрнберге',
            date: '12 декабря 2026',
            datetime: '2026-12-12',
            anchor: 'nuremberg',
            photoAlt: 'Участники встречи на общей фотографии',
            openPhoto: 'Открыть фотографию встречи целиком',
          },
        ],
      }
    : {
        heading: 'Nächste Veranstaltungen',
        value: [
          'Wir bieten dir ein gutes Umfeld',
          'und einen Anlass, dich wiederzusehen.',
        ],
        events: [
          {
            name: 'Transformationsspiele in München',
            date: '7. November 2026',
            datetime: '2026-11-07',
            anchor: 'games',
            photoAlt: 'Teilnehmende bei einem Transformationsspiel am Tisch',
            openPhoto: 'Foto des Spiels vollständig öffnen',
          },
          {
            name: 'Kennenlerntreffen und Christkindlesmarkt in Nürnberg',
            date: '12. Dezember 2026',
            datetime: '2026-12-12',
            anchor: 'nuremberg',
            photoAlt: 'Teilnehmende des Treffens auf einem Gruppenfoto',
            openPhoto: 'Foto des Treffens vollständig öffnen',
          },
        ],
      };
const photos = [
  {
    preview: '/images/rost-ti-preview.webp',
    previewSmall: '/images/rost-ti-preview-600.webp',
    previewAvif: '/images/rost-ti-preview.avif',
    previewSmallAvif: '/images/rost-ti-preview-600.avif',
    full: '/images/rost-ti-full.webp',
    fullAvif: '/images/rost-ti-full.avif',
    width: 1200,
    height: 798,
  },
  {
    preview: '/images/rost-networking-preview.webp',
    previewSmall: '/images/rost-networking-preview-600.webp',
    previewAvif: '/images/rost-networking-preview.avif',
    previewSmallAvif: '/images/rost-networking-preview-600.avif',
    full: '/images/rost-networking-full.webp',
    fullAvif: '/images/rost-networking-full.avif',
    width: 1200,
    height: 675,
  },
];
---

<section class="events" aria-labelledby="events-title">
  <div class="events__inner site-container">
    <div class="events__intro">
      <Heading
        as="h2"
        variant="section"
        class="events__heading"
        id="events-title"
      >
        {copy.heading}
      </Heading>
      <p class="events__value">
        {copy.value.map((line) => (
          <span>{line}</span>
        ))}
      </p>
    </div>

    <div class="events__grid">
      {copy.events.map((event, index) => (
        <article class="events__item">
          <a
            class:list={[
              'events__frame',
              { 'events__frame--game': index === 0 },
            ]}
            href={
              index === 0
                ? routes.tiGames[lang]
                : `${routes.events[lang]}#${event.anchor}`
            }
            aria-label={event.name}
          >
            <div
              class:list={[
                'events__photo',
                { 'events__photo--networking': index === 1 },
              ]}
            >
              <picture>
                <source
                  type="image/avif"
                  srcset={`${photos[index].previewSmallAvif} 600w, ${photos[index].previewAvif} 1200w`}
                  sizes="(min-width: 64rem) 600px, 100vw"
                />
                <source
                  type="image/webp"
                  srcset={`${photos[index].previewSmall} 600w, ${photos[index].preview} 1200w`}
                  sizes="(min-width: 64rem) 600px, 100vw"
                />
                <img
                  src={photos[index].preview}
                  alt=""
                  width={photos[index].width}
                  height={photos[index].height}
                  loading="lazy"
                  decoding="async"
                />
              </picture>
            </div>
          </a>
          <a
            class="events__link"
            href={`${routes.events[lang]}#${event.anchor}`}
          >
            <Heading as="h3" variant="card" class="events__name">
              {event.name}
            </Heading>
            <time class="events__date" datetime={event.datetime}>
              {event.date}
            </time>
          </a>
        </article>
      ))}
    </div>
  </div>
</section>
