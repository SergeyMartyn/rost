---
import { munichMeetup } from '../data/munich-meetup';
import Heading from './ui/Heading.astro';
import { routes, type Language } from '../lib/site';

const { lang } = Astro.props as { lang: Language };

const copy =
  lang === 'ru'
    ? {
        heading: 'Ближайшие мероприятия',
        value: [
          'Мы предлагаем вам хорошее окружение,',
          'а также повод встретиться снова.',
        ],
        events: [
          {
            name: munichMeetup.ru.title,
            date: munichMeetup.ru.date,
            datetime: munichMeetup.datetime,
            anchor: 'munich',
          },
          {
            name: 'Встреча-знакомство и рождественский рынок в Нюрнберге',
            date: '13 декабря 2026',
            datetime: '2026-12-13',
            anchor: 'nuremberg',
          },
        ],
      }
    : {
        heading: 'Nächste Veranstaltungen',
        value: [
          'Wir bieten dir ein gutes Umfeld',
          'und einen Anlass, dich wiederzusehen.',
        ],
        events: [
          {
            name: munichMeetup.de.title,
            date: munichMeetup.de.date,
            datetime: munichMeetup.datetime,
            anchor: 'munich',
          },
          {
            name: 'Kennenlerntreffen und Christkindlesmarkt in Nürnberg',
            date: '13. Dezember 2026',
            datetime: '2026-12-13',
            anchor: 'nuremberg',
          },
        ],
      };
const photos = [
  null,
  {
    preview: '/images/rost-networking-preview.webp',
    previewSmall: '/images/rost-networking-preview-600.webp',
    previewAvif: '/images/rost-networking-preview.avif',
    previewSmallAvif: '/images/rost-networking-preview-600.avif',
    width: 1200,
    height: 675,
  },
];
---

<section class="events" aria-labelledby="events-title">
  <div class="events__inner site-container">
    <div class="events__intro">
      <Heading
        as="h2"
        variant="section"
        class="events__heading"
        id="events-title"
      >
        {copy.heading}
      </Heading>
      <p class="events__value">
        {copy.value.map((line) => (
          <span>{line}</span>
        ))}
      </p>
    </div>

    <div class="events__grid">
      {copy.events.map((event, index) => {
        const photo = photos[index];
        return (
          <article class="events__item">
            <a
              class:list={[
                'events__frame',
                { 'events__frame--game': index === 0 },
              ]}
              href={
                index === 0
                  ? routes.munichMeetup[lang]
                  : `${routes.events[lang]}#${event.anchor}`
              }
              aria-label={event.name}
            >
              <div
                class:list={[
                  'events__photo',
                  { 'events__photo--networking': index === 1 },
                ]}
              >
                {photo ? (
                  <picture>
                    <source
                      type="image/avif"
                      srcset={`${photo.previewSmallAvif} 600w, ${photo.previewAvif} 1200w`}
                      sizes="(min-width: 64rem) 600px, 100vw"
                    />
                    <source
                      type="image/webp"
                      srcset={`${photo.previewSmall} 600w, ${photo.preview} 1200w`}
                      sizes="(min-width: 64rem) 600px, 100vw"
                    />
                    <img
                      src={photo.preview}
                      alt=""
                      width={photo.width}
                      height={photo.height}
                      loading="lazy"
                      decoding="async"
                    />
                  </picture>
                ) : (
                  <div class="grid h-full min-h-48 place-content-center bg-hero-end p-5 text-center text-brand">
                    <span class="font-display text-4xl md:text-5xl">
                      {munichMeetup[lang].city}
                    </span>
                    <span class="mt-2 font-semibold">{event.date}</span>
                  </div>
                )}
              </div>
            </a>
            <a
              class="events__link"
              href={
                index === 0
                  ? routes.munichMeetup[lang]
                  : `${routes.events[lang]}#${event.anchor}`
              }
            >
              <Heading as="h3" variant="card" class="events__name">
                {event.name}
              </Heading>
              <time class="events__date" datetime={event.datetime}>
                {event.date}
              </time>
            </a>
          </article>
        );
      })}
    </div>
  </div>
</section>
