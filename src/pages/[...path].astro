---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Events from '../components/Events.astro';
import EventPage from '../components/EventPage.astro';
import Formats from '../components/Formats.astro';
import Faq from '../components/Faq.astro';
import {
  routes,
  languages,
  text,
  site,
  type Language,
  type Page,
} from '../lib/site';
export function getStaticPaths() {
  return (Object.keys(routes) as Page[]).flatMap((page) =>
    languages.map((lang) => ({
      params: { path: routes[page][lang].slice(1, -1) },
      props: { page, lang },
    })),
  );
}
const { page, lang } = Astro.props as { page: Page; lang: Language };
const t = text[lang];
const title = page === 'home' ? t.title : t[page];
const legalText =
  page === 'imprint' || page === 'privacy' ? site.legalText[page][lang] : '';
const aboutCopy =
  lang === 'ru'
    ? {
        lead: 'R.O.S.T. объединяет людей, которым важно живое общение и новые знакомства.',
        body: 'Мы встречаемся, играем и проводим время вместе. Каждый формат — повод познакомиться ближе и найти людей, с которыми хочется увидеться снова.',
        action: 'Посмотреть мероприятия',
      }
    : {
        lead: 'R.O.S.T. bringt Menschen zusammen, denen persönliche Begegnungen und neue Bekanntschaften wichtig sind.',
        body: 'Wir treffen uns, spielen und verbringen Zeit miteinander. Jedes Format bietet Gelegenheit, einander näher kennenzulernen und Menschen zu finden, die man gern wiedersehen möchte.',
        action: 'Veranstaltungen ansehen',
      };
const contactCopy =
  lang === 'ru'
    ? {
        lead: 'Есть вопрос о встрече или хотите связаться с нами?',
        body: 'Напишите нам по электронной почте. Мы ответим, как только сможем.',
        email: 'Написать письмо',
      }
    : {
        lead: 'Hast du eine Frage zu einem Treffen oder möchtest du uns schreiben?',
        body: 'Schreib uns per E-Mail. Wir antworten, sobald wir können.',
        email: 'E-Mail schreiben',
      };
---

<Layout
  lang={lang}
  page={page}
  title={title}
  description={
    page === 'home' ? t.description : `${t[page]} — ${site.name || t.legal}`
  }
>
  {page === 'home' ? (
    <>
      <Hero lang={lang} />
      <Events lang={lang} />
      <Formats lang={lang} />
      <Faq lang={lang} />
    </>
  ) : page === 'events' ? (
    <EventPage lang={lang} />
  ) : page === 'about' ? (
    <section class="font-hero-sans text-brand max-w-4xl">
      <p class="text-sm font-bold uppercase tracking-widest text-accent mb-5">
        R.O.S.T.
      </p>
      <h1 class="font-display text-5xl md:text-7xl leading-tight mb-8">
        {title}
      </h1>
      <p class="text-xl md:text-2xl leading-relaxed mb-6">{aboutCopy.lead}</p>
      <p class="text-lg text-muted leading-relaxed mb-10">{aboutCopy.body}</p>
      <a
        class="inline-flex rounded-2xl bg-brand px-6 py-4 font-bold text-white hover:bg-accent"
        href={routes.events[lang]}
      >
        {aboutCopy.action} →
      </a>
    </section>
  ) : page === 'contacts' ? (
    <section class="font-hero-sans text-brand max-w-4xl">
      <p class="text-sm font-bold uppercase tracking-widest text-accent mb-5">
        R.O.S.T.
      </p>
      <h1 class="font-display text-5xl md:text-7xl leading-tight mb-8">
        {title}
      </h1>
      <p class="text-xl md:text-2xl leading-relaxed mb-6">{contactCopy.lead}</p>
      <p class="text-lg text-muted leading-relaxed mb-10">{contactCopy.body}</p>
      <a
        class="inline-flex rounded-2xl bg-brand px-6 py-4 font-bold text-white hover:bg-accent"
        href={`mailto:${site.legal.email}`}
      >
        {contactCopy.email} →
      </a>
      <p class="mt-5 text-muted">{site.legal.email}</p>
    </section>
  ) : (
    <div class="font-hero-sans">
      {!legalText && <p class="text-brand mb-5">{t.legal}</p>}
      <h1 class="font-display text-2xl md:text-5xl lg:text-6xl leading-tight text-brand mb-8">
        {title}
      </h1>
      {!legalText && <p class="mb-8 text-muted">{t.legalNote}</p>}
      <dl class="space-y-5">
        {(page === 'imprint'
          ? ['operator', 'address', 'email']
          : ['operator', 'privacyContact', 'email']
        ).map((key) => (
          <div>
            <dt class="font-bold text-brand">{t[key as keyof typeof t]}</dt>
            <dd>{site.legal[key as 'operator'] || `[${t.legal}]`}</dd>
          </div>
        ))}
      </dl>
      {legalText ? (
        <div class="mt-8 space-y-6 leading-relaxed">
          {legalText.split('\n\n').map((section: string) => {
            const lines = section.split('\n');
            const isHeadingOnly = lines.length === 1 && lines[0].length < 120;
            const heading =
              lines.length > 1 ? lines[0] : isHeadingOnly ? lines[0] : null;
            const bodyLines =
              lines.length > 1 ? lines.slice(1) : isHeadingOnly ? [] : lines;
            const body = bodyLines.join(' ');
            return (
              <div>
                {heading && <p class="font-bold text-brand mb-2">{heading}</p>}
                {body && <p>{body}</p>}
              </div>
            );
          })}
        </div>
      ) : (
        <p class="mt-8 leading-relaxed">
          {`[${lang === 'ru' ? 'Текст страницы: нужно подготовить и проверить' : 'Seitentext: ergänzen und prüfen'}]`}
        </p>
      )}
    </div>
  )}
</Layout>
