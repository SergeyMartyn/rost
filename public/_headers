# Security and caching rules for the R.O.S.T. site.
# Parsed by Cloudflare Workers Static Assets; this file is not served itself.
# Note: these rules apply to static asset responses only. The "/" language
# redirect is generated by worker/index.ts and is not covered here.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Strict-Transport-Security: max-age=31536000

# Hashed build assets never change under the same name.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Self-hosted fonts and icons are stable.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/icons/*
  Cache-Control: public, max-age=31536000, immutable

# Photos may be replaced under the same name, so keep a moderate TTL.
/images/*
  Cache-Control: public, max-age=2592000

# A Content-Security-Policy is intentionally not set yet: the site uses inline
# Astro scripts/styles and will add an external payment script. Add a tested
# policy together with that integration, for example:
#   Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com; frame-src https://www.youtube-nocookie.com https://www.google.com; img-src 'self' data: https://www.googletagmanager.com https://www.google-analytics.com
